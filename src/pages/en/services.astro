---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/sections/CTA.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const services = [
  {
    key: '1',
    icon: '⚡',
    metric: '< 0.9s',
    metricLabel: 'average load time across all sites',
    accentColor: '#FF2040',
  },
  {
    key: '2',
    icon: '◎',
    metric: '#1',
    metricLabel: 'on Google within 30 days on average',
    accentColor: '#2B52FF',
  },
  {
    key: '3',
    icon: '✦',
    metric: '0',
    metricLabel: 'templates used — ever',
    accentColor: '#3DFF7A',
  },
  {
    key: '4',
    icon: '⊕',
    metric: '30 min',
    metricLabel: 'training to master your CMS',
    accentColor: '#7C9EFF',
  },
  {
    key: '5',
    icon: '⊙',
    metric: '100 %',
    metricLabel: 'GDPR-compliant from day one',
    accentColor: '#3DFF7A',
  },
  {
    key: '6',
    icon: '◷',
    metric: '7 d',
    metricLabel: 'minimum delivery, guaranteed by contract',
    accentColor: '#FFB547',
  },
];

const SVG = {
  astro: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 2L14 13H6L10 2Z" fill="currentColor"/>
    <path d="M6 13C4.8 15.2 4 17.8 4.5 18.5C6 16 7.8 15 10 15C12.2 15 14 16 15.5 18.5C16 17.8 15.2 15.2 14 13H6Z" fill="currentColor" opacity="0.55"/>
  </svg>`,
  typescript: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="2" y="2" width="16" height="16" rx="2.5" stroke="currentColor" stroke-width="1.4"/>
    <path d="M5.5 8.5H10.5M8 8.5V15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M13 13C13 14 13.7 14.8 14.5 14.8C15.3 14.8 16 14 16 13C16 11.5 13 11.5 13 10C13 9 13.7 8.2 14.5 8.2C15.3 8.2 16 9 16 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>`,
  tailwind: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M3 7C4.5 5 6.5 5 8 7C9.5 9 11.5 9 13 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M3 11C4.5 9 6.5 9 8 11C9.5 13 11.5 13 13 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M7 15C8.5 13 10.5 13 12 15C13.5 17 15.5 17 17 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
  </svg>`,
  vercel: `<svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 2L18.5 17H1.5L10 2Z"/>
  </svg>`,
  storyblok: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="3" y="5" width="14" height="11" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <path d="M3 9H17" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    <path d="M6.5 3H14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.6"/>
    <path d="M7 12.5H10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    <path d="M7 14.5H13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
  </svg>`,
  plausible: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 17H18" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    <path d="M4 17V13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M8 17V10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M12 17V7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M16 17V4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>`,
  spaceGrotesk: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M3 16L10 3L17 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M6.5 11.5H13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>`,
  inter: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 3V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M7 3H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M7 17H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M4 10H7M13 10H16" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.35"/>
  </svg>`,
  webp: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <path d="M2 12.5L6 8.5L9.5 11.5L13 8L18 13.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="6.5" cy="7.5" r="1.2" fill="currentColor"/>
  </svg>`,
  schema: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="10" cy="4" r="2" stroke="currentColor" stroke-width="1.4"/>
    <circle cx="4" cy="15.5" r="2" stroke="currentColor" stroke-width="1.4"/>
    <circle cx="16" cy="15.5" r="2" stroke="currentColor" stroke-width="1.4"/>
    <path d="M8.3 5.6L5.5 13.7M11.7 5.6L14.5 13.7M6 15.5H14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.6"/>
  </svg>`,
};

const stack = [
  { name: 'Astro 5',          version: 'v5.x',     icon: SVG.astro,        desc: 'Zero JS by default' },
  { name: 'TypeScript',       version: '5.x',      icon: SVG.typescript,   desc: 'Strict typing' },
  { name: 'Tailwind CSS 4',   version: 'v4.x',     icon: SVG.tailwind,     desc: 'CSS-first' },
  { name: 'Vercel Edge',      version: '100+ PoP', icon: SVG.vercel,       desc: 'Global CDN' },
  { name: 'Storyblok',        version: 'v2',       icon: SVG.storyblok,    desc: 'Visual headless CMS' },
  { name: 'Plausible',        version: 'GDPR',     icon: SVG.plausible,    desc: 'Lightweight analytics' },
  { name: 'Space Grotesk',    version: 'Variable', icon: SVG.spaceGrotesk, desc: 'Self-hosted' },
  { name: 'Inter Variable',   version: 'Variable', icon: SVG.inter,        desc: 'Self-hosted' },
  { name: 'WebP / AVIF',      version: 'Auto',     icon: SVG.webp,         desc: 'Optimised images' },
  { name: 'Schema.org',       version: 'JSON-LD',  icon: SVG.schema,       desc: 'Structured SEO' },
];

const steps = [
  { num: '01', title: 'Discovery',    detail: '45 min' },
  { num: '02', title: 'Design',       detail: 'Figma' },
  { num: '03', title: 'Development',  detail: 'Astro' },
  { num: '04', title: 'Launch',       detail: 'Vercel' },
];
---

<BaseLayout
  title={t('page.services.title')}
  description={t('page.services.desc')}
>

  <!-- ══════════════════════════════════════════
       SECTION 1 — HERO SPLIT
       Left: typographic sculpture
       Right: real Astro code, syntax-highlighted
  ══════════════════════════════════════════ -->
  <section class="svc-hero" aria-label="Services introduction">
    <!-- Left: large title block -->
    <div class="svc-hero__left">
      <div class="svc-hero__label">The Workshop in Detail</div>
      <h1 class="svc-hero__title">
        <span class="svc-hero__title-line">Ser&shy;</span>
        <span class="svc-hero__title-line svc-hero__title-line--offset">vices.</span>
      </h1>
      <p class="svc-hero__sub">
        What we build, how we build it, and why every technical decision has a measurable impact on your revenue.
      </p>
      <div class="svc-hero__guarantee">
        <span class="svc-hero__g-num">95–100</span>
        <span class="svc-hero__g-label">Lighthouse score<br>guaranteed by contract</span>
      </div>
    </div>

    <!-- Vertical separator -->
    <div class="svc-hero__sep" aria-hidden="true"></div>

    <!-- Right: code snippet -->
    <div class="svc-hero__right" aria-label="Astro component example">
      <div class="svc-code-header">
        <span class="svc-code-dot" style="background:#FF5F57" aria-hidden="true"></span>
        <span class="svc-code-dot" style="background:#FEBC2E" aria-hidden="true"></span>
        <span class="svc-code-dot" style="background:#28C840" aria-hidden="true"></span>
        <span class="svc-code-filename">ServiceCard.astro</span>
      </div>
      <pre class="svc-code-block" aria-label="Example Astro component"><code><span class="t-comment">---</span>
<span class="t-kw">interface</span> <span class="t-type">Props</span> {
  <span class="t-prop">title</span><span class="t-punct">:</span> <span class="t-type">string</span><span class="t-punct">;</span>
  <span class="t-prop">score</span><span class="t-punct">:</span> <span class="t-type">number</span><span class="t-punct">;</span>
  <span class="t-prop">lang</span><span class="t-punct">:</span> <span class="t-str">'fr'</span> <span class="t-punct">|</span> <span class="t-str">'en'</span><span class="t-punct">;</span>
}

<span class="t-kw">const</span> { <span class="t-prop">title</span><span class="t-punct">,</span> <span class="t-prop">score</span><span class="t-punct">,</span> <span class="t-prop">lang</span> } <span class="t-punct">=</span>
  <span class="t-fn">Astro.props</span><span class="t-punct">;</span>
<span class="t-comment">---</span>

<span class="t-tag">&lt;article</span> <span class="t-attr">class</span><span class="t-punct">=</span><span class="t-str">"card"</span>
         <span class="t-attr">lang</span><span class="t-punct">=</span><span class="t-expr">&#123;lang&#125;</span><span class="t-tag">&gt;</span>
  <span class="t-tag">&lt;h3&gt;</span><span class="t-expr">&#123;title&#125;</span><span class="t-tag">&lt;/h3&gt;</span>

  <span class="t-tag">&lt;meter</span>
    <span class="t-attr">value</span><span class="t-punct">=</span><span class="t-expr">&#123;score&#125;</span>
    <span class="t-attr">min</span><span class="t-punct">=</span><span class="t-str">"0"</span>
    <span class="t-attr">max</span><span class="t-punct">=</span><span class="t-str">"100"</span>
    <span class="t-attr">optimum</span><span class="t-punct">=</span><span class="t-str">"100"</span>
  <span class="t-tag">/&gt;</span>

  <span class="t-tag">&lt;p</span> <span class="t-attr">class</span><span class="t-punct">=</span><span class="t-str">"score"</span><span class="t-tag">&gt;</span>
    <span class="t-expr">&#123;score&#125;</span><span class="t-tag">&lt;span&gt;</span><span class="t-plain"> / 100</span><span class="t-tag">&lt;/span&gt;</span>
  <span class="t-tag">&lt;/p&gt;</span>
<span class="t-tag">&lt;/article&gt;</span></code></pre>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 2 — SERVICES DETAIL
       Full-width rows, alternating bg,
       left=content right=metric
  ══════════════════════════════════════════ -->
  <section class="svc-detail" id="services" aria-label="Services detail">
    <div class="svc-detail__header reveal">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t('services.eyebrow')}
      </div>
      <h2 class="svc-detail__h2">{t('services.h2')}</h2>
    </div>

    <div class="svc-rows" role="list">
      {services.map((svc, i) => (
        <article
          class={`svc-row svc-row--${i % 2 === 0 ? 'even' : 'odd'} reveal`}
          style={`--row-accent: ${svc.accentColor}; transition-delay: ${i * 60}ms`}
          role="listitem"
        >
          <div class="svc-row__left">
            <div class="svc-row__icon" aria-hidden="true">{svc.icon}</div>
            <div class="svc-row__content">
              <h3 class="svc-row__title">
                {t(`services.${svc.key}.title` as Parameters<typeof t>[0])}
              </h3>
              <p class="svc-row__text">
                {t(`services.${svc.key}.text` as Parameters<typeof t>[0])}
              </p>
            </div>
          </div>
          <div class="svc-row__right" aria-label={`Key metric: ${svc.metric}`}>
            <div class="svc-row__metric">{svc.metric}</div>
            <div class="svc-row__metric-label">{svc.metricLabel}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 3 — TECH STACK
       Always dark, pill layout
  ══════════════════════════════════════════ -->
  <section class="svc-stack" aria-label="Tech stack">
    <div class="container">
      <div class="svc-stack__header reveal">
        <div class="eyebrow" style="color:#3DFF7A">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          Tech stack
        </div>
        <h2 class="svc-stack__h2">Our Technical Stack</h2>
        <p class="svc-stack__sub">
          Every tool chosen for a specific reason. No unnecessary dependencies.
        </p>
      </div>
      <div class="svc-stack__grid" role="list">
        {stack.map((tech, i) => (
          <div
            class="svc-pill reveal"
            style={`transition-delay: ${i * 45}ms`}
            role="listitem"
          >
            <span class="svc-pill__icon" aria-hidden="true" set:html={tech.icon}></span>
            <span class="svc-pill__name">{tech.name}</span>
            <span class="svc-pill__version">{tech.version}</span>
            <span class="svc-pill__desc">{tech.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 4 — PROCESS REMINDER
       Minimal horizontal 4-step flow
  ══════════════════════════════════════════ -->
  <section class="svc-process" aria-label="Delivery process">
    <div class="container">
      <div class="svc-process__header reveal">
        <div class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          {t('process.eyebrow')}
        </div>
        <h2 class="svc-process__h2">{t('process.h2')}</h2>
      </div>

      <div class="svc-steps" role="list" aria-label="Process steps">
        {steps.map((step, i) => (
          <div class="svc-step reveal" style={`transition-delay: ${i * 80}ms`} role="listitem">
            <div class="svc-step__num" aria-hidden="true">{step.num}</div>
            <div class="svc-step__title">{step.title}</div>
            <div class="svc-step__detail">{step.detail}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA lang={lang} />

</BaseLayout>

<style>
  /* ══════════════════════════════════════════
     HERO SPLIT
  ══════════════════════════════════════════ */

  .svc-hero {
    background: #08090F;
    color: #E0E8FF;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    min-height: 100svh;
    padding-top: 64px; /* nav height */
    position: relative;
  }

  .svc-hero__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 4vw, 4rem);
    gap: 2rem;
  }

  .svc-hero__label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #3DFF7A;
  }

  .svc-hero__title {
    font-family: var(--font-display);
    font-size: clamp(5rem, 13vw, 11rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.88;
    color: #E0E8FF;
    display: flex;
    flex-direction: column;
  }

  .svc-hero__title-line--offset {
    padding-left: 0.15em;
    color: #3DFF7A;
  }

  .svc-hero__sub {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    color: #5B6FA3;
    line-height: 1.75;
    max-width: 42ch;
    margin: 0;
  }

  .svc-hero__guarantee {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-left: 3px solid #3DFF7A;
    padding-left: 1.25rem;
    margin-top: 0.5rem;
  }

  .svc-hero__g-num {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #3DFF7A;
    line-height: 1;
  }

  .svc-hero__g-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5B6FA3;
    line-height: 1.5;
  }

  /* Vertical separator line */
  .svc-hero__sep {
    background: #3DFF7A;
    opacity: 0.22;
    width: 1px;
    align-self: stretch;
  }

  /* Code panel */
  .svc-hero__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 5rem) clamp(1.5rem, 4vw, 3.5rem);
    background: #060710;
  }

  .svc-code-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #0C0E1A;
    border: 1px solid #1C2A50;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    padding: 0.6rem 1rem;
  }

  .svc-code-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .svc-code-filename {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #5B6FA3;
    margin-left: 0.5rem;
    letter-spacing: 0.04em;
  }

  .svc-code-block {
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.1vw, 0.82rem);
    line-height: 1.7;
    background: #0C0E1A;
    border: 1px solid #1C2A50;
    border-radius: 0 0 8px 8px;
    padding: 1.5rem 1.75rem;
    overflow-x: auto;
    margin: 0;
    white-space: pre;
  }

  /* Syntax highlight token classes */
  .t-comment { color: #3D4E78; }
  .t-kw      { color: #7C9EFF; }
  .t-type    { color: #FFB547; }
  .t-prop    { color: #E0E8FF; }
  .t-punct   { color: #5B6FA3; }
  .t-str     { color: #3DFF7A; }
  .t-fn      { color: #7C9EFF; }
  .t-tag     { color: #FF7CA8; }
  .t-attr    { color: #FFB547; }
  .t-expr    { color: #3DFF7A; }
  .t-plain   { color: #E0E8FF; }

  /* ══════════════════════════════════════════
     SERVICES DETAIL ROWS
  ══════════════════════════════════════════ */

  .svc-detail {
    background: var(--c-bg);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .svc-detail__header {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .svc-detail__h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    max-width: 28ch;
    margin-top: 0.5rem;
  }

  .svc-rows {
    display: flex;
    flex-direction: column;
  }

  .svc-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    padding: clamp(2rem, 4vw, 3.25rem) clamp(1.25rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--c-border);
    transition: background 250ms ease;
    cursor: default;
  }

  .svc-row:first-of-type {
    border-top: 1px solid var(--c-border);
  }

  .svc-row:hover {
    background: color-mix(in srgb, var(--row-accent) 4%, transparent);
  }

  .svc-row:hover .svc-row__title {
    color: var(--row-accent);
  }

  .svc-row__left {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .svc-row__icon {
    font-size: 1.75rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.2rem;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--row-accent) 50%, transparent));
  }

  .svc-row__content {
    flex: 1;
  }

  .svc-row__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--c-text);
    margin-bottom: 0.5rem;
    transition: color 200ms ease;
  }

  .svc-row__text {
    font-size: 0.9rem;
    color: var(--c-text-muted);
    line-height: 1.75;
    max-width: 58ch;
    margin: 0;
  }

  .svc-row__right {
    text-align: right;
    flex-shrink: 0;
    min-width: 160px;
    padding-left: 2rem;
    border-left: 1px solid var(--c-border);
  }

  .svc-row__metric {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--row-accent);
    line-height: 1;
