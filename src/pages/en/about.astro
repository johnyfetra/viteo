---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const stackItems = [
  { key: '1', letter: 'A' },
  { key: '2', letter: 'V' },
  { key: '3', letter: 'T' },
  { key: '4', letter: 'W' },
  { key: '5', letter: 'S' },
  { key: '6', letter: 'P' },
] as const;

const values = [
  { num: '01', key: '1' },
  { num: '02', key: '2' },
  { num: '03', key: '3' },
] as const;
---

<BaseLayout
  title={t('page.about.title')}
  description={t('page.about.desc')}
>

  <!-- ═══════════════════════════════════
       SECTION 1 — MANIFESTO HERO
       Always dark, full-screen editorial
       ═══════════════════════════════════ -->
  <section class="s-manifesto" aria-label="Manifesto">
    <div class="manifesto-inner">
      <p class="manifesto-line line-1 reveal-line">{t('about.manifesto.line1')}</p>
      <p class="manifesto-line line-2 reveal-line" style="animation-delay:0.12s">{t('about.manifesto.line2')}</p>
      <hr class="manifesto-rule reveal-line" style="animation-delay:0.26s" aria-hidden="true" />
      <p class="manifesto-line line-3 reveal-line" style="animation-delay:0.38s">{t('about.manifesto.line3')}</p>
      <p class="manifesto-line line-4 reveal-line" style="animation-delay:0.5s">{t('about.manifesto.line4')}</p>
      <div class="manifesto-sig reveal-line" style="animation-delay:0.7s">
        <span class="sig-text">{t('about.manifesto.sig')}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 2 — VALUES
       Adapts light/dark, horizontal row
       ═══════════════════════════════════ -->
  <section class="s-values" aria-labelledby="values-heading">
    <div class="container">
      <div class="values-eyebrow eyebrow reveal">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        Our commitments
      </div>
      <h2 class="values-heading reveal" id="values-heading">What doesn't change, project after project.</h2>
      <div class="values-row">
        {values.map(({ num, key }, i) => (
          <div class={`value-item reveal reveal-delay-${i + 1}`}>
            <span class="value-ghost-num" aria-hidden="true">{num}</span>
            <div class="value-content">
              <h3 class="value-title">{t(`about.values.${key}.title` as Parameters<typeof t>[0])}</h3>
              <p class="value-text">{t(`about.values.${key}.text` as Parameters<typeof t>[0])}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 3 — STACK SNAPSHOT
       Always dark-warm
       ═══════════════════════════════════ -->
  <section class="s-stack" aria-labelledby="stack-heading">
    <div class="container">
      <div class="stack-header">
        <div class="eyebrow reveal">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          {t('about.stack.eyebrow')}
        </div>
        <h2 class="stack-h2 reveal" id="stack-heading">{t('about.stack.h2')}</h2>
        <p class="stack-intro reveal reveal-delay-1">{t('about.stack.intro')}</p>
      </div>
      <div class="stack-grid">
        {stackItems.map(({ key, letter }, i) => (
          <div class={`stack-item reveal reveal-delay-${(i % 3) + 1}`}>
            <span class="stack-letter" aria-hidden="true">{letter}</span>
            <div class="stack-content">
              <strong class="stack-name">{t(`about.stack.${key}.name` as Parameters<typeof t>[0])}</strong>
              <p class="stack-why">{t(`about.stack.${key}.why` as Parameters<typeof t>[0])}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 4 — GUARANTEE CARD
       Solid accent green, always
       ═══════════════════════════════════ -->
  <section class="s-garantie" aria-labelledby="garantie-heading">
    <div class="container">
      <div class="garantie-inner">
        <div class="garantie-left">
          <div class="garantie-eyebrow">{t('about.garantie.eyebrow')}</div>
          <h2 class="garantie-score" id="garantie-heading">
            <span class="garantie-num">95<span class="garantie-sep">–</span>100</span>
            <span class="garantie-denom">/ 100</span>
          </h2>
          <p class="garantie-label">{t('about.garantie.label')}</p>
        </div>
        <div class="garantie-right">
          <p class="garantie-text">{t('about.garantie.text')}</p>
          <ul class="garantie-checks" aria-label="Guaranteed metrics">
            {(['detail1', 'detail2', 'detail3', 'detail4'] as const).map(d => (
              <li class="garantie-check">
                <span class="check-mark" aria-hidden="true">✓</span>
                {t(`about.garantie.${d}` as Parameters<typeof t>[0])}
              </li>
            ))}
          </ul>
          <p class="garantie-footnote">{t('about.garantie.footnote')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       SECTION 5 — CTA
       Darkest, cinematic, minimal
       ═══════════════════════════════════ -->
  <section class="s-about-cta" aria-labelledby="about-cta-heading">
    <div class="container">
      <div class="about-cta-inner">
        <h2 class="about-cta-h2" id="about-cta-heading">{t('about.cta.h2')}</h2>
        <p class="about-cta-sub">{t('about.cta.sub')}</p>
        <a href={localizePath('/contact', lang)} class="btn btn-primary btn-lg about-cta-btn">
          {t('about.cta.btn')}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ════════════════════════════════════
   MANIFESTO HERO
   ════════════════════════════════════ */

.s-manifesto {
  background: #05060A;
  color: #E0E8FF;
  min-height: 100svh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 80px; /* nav clearance */
  padding-bottom: var(--space-2xl);
  overflow: hidden;
}

.manifesto-inner {
  padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  max-width: 1100px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}

/* Stagger-in animation */
@keyframes manifesto-reveal {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.reveal-line {
  animation: manifesto-reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.manifesto-line {
  font-family: var(--font-display);
  font-weight: 300;
  line-height: 1.06;
  letter-spacing: -0.04em;
  font-size: clamp(3rem, 7.5vw, 7rem);
  color: #E0E8FF;
  margin: 0;
  max-width: none;
}

/* Accent the conviction lines */
.line-4 {
  color: #3DFF7A;
  font-weight: 600;
}

.manifesto-rule {
  border: none;
  border-top: 1px solid rgba(224, 232, 255, 0.14);
  width: 100%;
  margin-block: clamp(1.5rem, 3vw, 2.5rem);
}

.manifesto-sig {
  margin-top: clamp(2rem, 4vw, 3.5rem);
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.sig-text {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  color: rgba(224, 232, 255, 0.35);
  text-transform: uppercase;
}

/* ════════════════════════════════════
   VALUES SECTION
   Adapts to theme (light bg in light mode)
   ════════════════════════════════════ */

.s-values {
  background: var(--s-stats-bg, #F4F3EF);
  color: var(--s-stats-text, #0F0D0B);
  padding-block: var(--space-2xl);
}

.s-values .eyebrow {
  color: var(--c-accent);
}

.values-heading {
  font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  max-width: 32ch;
  margin-bottom: var(--space-lg);
  color: var(--s-stats-text, #0F0D0B);
}

.values-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--c-border);
}

.value-item {
  position: relative;
  padding: 2.5rem 2rem 2.5rem 0;
  border-right: 1px solid var(--c-border);
  overflow: hidden;
}

.value-item:first-child {
  padding-left: 0;
}

.value-item:last-child {
  border-right: none;
  padding-right: 0;
}

.value-ghost-num {
  position: absolute;
  top: 1rem;
  right: 1.5rem;
  font-family: var(--font-mono);
  font-size: clamp(4rem, 8vw, 7rem);
  font-weight: 700;
  letter-spacing: -0.06em;
  color: var(--s-stats-text, #0F0D0B);
  opacity: 0.04;
  line-height: 1;
  pointer-events: none;
  user-select: none;
}

.value-content {
  position: relative;
  z-index: 1;
}

.value-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  margin-bottom: 0.75rem;
  color: var(--s-stats-text, #0F0D0B);
}

.value-text {
  font-size: 0.9rem;
  line-height: 1.75;
  color: var(--c-text-muted);
  max-width: 38ch;
}

/* ════════════════════════════════════
   STACK SECTION
   Always dark-warm
   ════════════════════════════════════ */

.s-stack {
  background: #080C10;
  color: #E8EAF0;
  padding-block: var(--space-2xl);
}

.s-stack .eyebrow {
  color: #3DFF7A;
}

.stack-header {
  margin-bottom: var(--space-xl);
}

.stack-h2 {
  font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  max-width: 28ch;
  margin-bottom: 1rem;
  color: #E8EAF0;
}

.stack-intro {
  font-size: 0.95rem;
  line-height: 1.75;
  color: rgba(232, 234, 240, 0.5);
  max-width: 60ch;
}

.stack-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: rgba(255,255,255,0.06);
}

.stack-item {
  background: #080C10;
  padding: 2rem 1.75rem;
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  transition: background 0.25s var(--ease-out);
}

.stack-item:hover {
  background: rgba(61, 255, 122, 0.04);
}

.stack-letter {
  font-family: var(--font-mono);
  font-size: 2rem;
  font-weight: 700;
  color: #3DFF7A;
  opacity: 0.5;
  line-height: 1;
  flex-shrink: 0;
  letter-spacing: -0.04em;
  transition: opacity 0.25s var(--ease-out);
}

.stack-item:hover .stack-letter {
  opacity: 1;
}

.stack-content {
  flex: 1;
}

.stack-name {
  display: block;
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #E8EAF0;
  margin-bottom: 0.5rem;
}

.stack-why {
  font-size: 0.85rem;
  line-height: 1.7;
  color: rgba(232, 234, 240, 0.5);
  max-width: 100%;
}

/* ════════════════════════════════════
   GARANTIE SECTION
   Solid accent, always green
   ════════════════════════════════════ */

.s-garantie {
  background: #3DFF7A;
  color: #05060A;
  padding-block: var(--space-2xl);
}

:global([data-theme="light"]) .s-garantie {
  background: #007A34;
  color: #F4F3EF;
}

.garantie-inner {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 4rem;
  align-items: center;
}

.garantie-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(5, 6, 10, 0.5);
  margin-bottom: 1.25rem;
}

:global([data-theme="light"]) .garantie-eyebrow {
  color: rgba(244, 243, 239, 0.6);
}

.garantie-score {
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
  margin-bottom: 0.5rem;
  line-height: 1;
}

.garantie-num {
  font-family: var(--font-mono);
  font-size: clamp(3.5rem, 8vw, 6.5rem);
  font-weight: 700;
  letter-spacing: -0.05em;
  color: #05060A;
}

:global([data-theme="light"]) .garantie-num {
  color: #F4F3EF;
}

.garantie-sep {
  font-weight: 300;
  opacity: 0.5;
}

.garantie-denom {
  font-family: var(--font-mono);
  font-size: 1.25rem;
  color: rgba(5, 6, 10, 0.5);
  align-self: flex-end;
  padding-bottom: 0.4em;
}

:global([data-theme="light"]) .garantie-denom {
  color: rgba(244, 243, 239, 0.5);
}

.garantie-label {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(5, 6, 10, 0.6);
  max-width: none;
}

:global([data-theme="light"]) .garantie-label {
  color: rgba(244, 243, 239, 0.6);
}

.garantie-text {
  font-size: 1.1rem;
  line-height: 1.7;
  font-weight: 500;
  color: #05060A;
  margin-bottom: 1.75rem;
  max-width: 50ch;
}

:global([data-theme="light"]) .garantie-text {
  color: #F4F3EF;
}

.garantie-checks {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem 1.5rem;
  margin-bottom: 1.5rem;
}

.garantie-check {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: rgba(5, 6, 10, 0.8);
  font-weight: 600;
}

:global([data-theme="light"]) .garantie-check {
  color: rgba(244, 243, 239, 0.85);
}

.check-mark {
  font-size: 0.9rem;
  font-weight: 700;
  color: #05060A;
}

:global([data-theme="light"]) .check-mark {
  color: #F4F3EF;
}

.garantie-footnote {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.02em;
  color: rgba(5, 6, 10, 0.4);
  border-top: 1px solid rgba(5, 6, 10, 0.15);
  padding-top: 1rem;
  max-width: 100%;
}

:global([data-theme="light"]) .garantie-footnote {
  color: rgba(244, 243, 239, 0.45);
  border-top-color: rgba(244, 243, 239, 0.2);
}

/* ════════════════════════════════════
   ABOUT CTA
   Darkest, minimal
   ════════════════════════════════════ */

.s-about-cta {
  background: #030408;
  color: #F0EFE8;
  padding-block: var(--space-2xl);
}

.about-cta-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.25rem;
}

.about-cta-h2 {
  font-size: clamp(2rem, 4.5vw, 3.5rem);
  color: #F0EFE8;
  max-width: 20ch;
}

.about-cta-sub {
  font-size: 1rem;
  color: rgba(240, 239, 232, 0.5);
  max-width: 40ch;
}

.about-cta-btn {
  margin-top: 0.5rem;
}

/* ════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════ */

@media (max-width: 860px) {
  .values-row {
    grid-template-columns: 1fr;
  }
  .value-item {
    border-right: none;
    border-bottom: 1px solid var(--c-border);
    padding: 2rem 0;
  }
  .value-item:last-child {
    border-bottom: none;
  }

  .stack-grid {
    grid-template-columns: 1fr;
  }

  .garantie-inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

@media (max-width: 520px) {
  .manifesto-line {
    font-size: clamp(2.2rem, 10vw, 3.5rem);
  }

  .garantie-checks {
    grid-template-columns: 1fr;
  }
}

/* ════════════════════════════════════
   REDUCED MOTION
   ════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .reveal-line {
    animation: none;
    opacity: 1;
    transform: none;
  }
}
</style>
