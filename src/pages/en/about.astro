---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/sections/CTA.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout
  title={t('page.about.title')}
  description={t('page.about.desc')}
>
  <section class="page-hero section-sm">
    <div class="container about-hero-inner">
      <div class="about-hero-text">
        <div class="eyebrow reveal">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          {t('about.eyebrow')}
        </div>
        <h1 class="about-h1 reveal">{t('about.h1')}</h1>
        <div class="about-manifesto">
          <p class="about-p reveal">{t('about.p1')}</p>
          <p class="about-p reveal reveal-delay-1">{t('about.p2')}</p>
          <p class="about-p reveal reveal-delay-2">{t('about.p3')}</p>
        </div>
      </div>
      <div class="guarantee-card reveal reveal-delay-3">
        <div class="guarantee-head"><span aria-hidden="true">◉</span> The Viteo Guarantee</div>
        <div class="guarantee-score"><span class="guarantee-num metric-value">95</span><span class="guarantee-unit">/ 100</span></div>
        <p class="guarantee-text">Minimum Lighthouse score guaranteed by contract at every project delivery.</p>
        <div class="guarantee-details">
          <div class="guarantee-detail"><span class="gd-check" aria-hidden="true">✓</span>Performance</div>
          <div class="guarantee-detail"><span class="gd-check" aria-hidden="true">✓</span>SEO</div>
          <div class="guarantee-detail"><span class="gd-check" aria-hidden="true">✓</span>Accessibility</div>
          <div class="guarantee-detail"><span class="gd-check" aria-hidden="true">✓</span>Best Practices</div>
        </div>
        <p class="guarantee-footnote">If this score isn't achieved on delivery day, you don't pay the balance.</p>
      </div>
    </div>
  </section>

  <section class="section values-section">
    <div class="container">
      <div class="eyebrow reveal"><span class="eyebrow-dot" aria-hidden="true"></span>Our commitments</div>
      <h2 class="values-h2 reveal">What doesn't change, project after project.</h2>
      <div class="values-grid">
        {(['1', '2', '3'] as const).map((n, i) => (
          <div class={`value-card reveal reveal-delay-${i + 1}`}>
            <div class="value-num metric-value" aria-hidden="true">0{n}</div>
            <h3 class="value-title">{t(`about.values.${n}.title` as Parameters<typeof t>[0])}</h3>
            <p class="value-text">{t(`about.values.${n}.text` as Parameters<typeof t>[0])}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</BaseLayout>

<style>
  .page-hero { background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding-top: calc(60px + var(--space-xl)); }
  .about-hero-inner { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 4rem; align-items: start; }
  .about-h1 { font-size: clamp(2rem, 5vw, 3.5rem); max-width: 22ch; margin-bottom: 2rem; margin-top: 0.5rem; }
  .about-manifesto { display: flex; flex-direction: column; gap: 1.25rem; }
  .about-p { font-size: 1.05rem; color: var(--c-text-muted); max-width: 60ch; line-height: 1.8; }
  .guarantee-card { background: var(--c-bg); border: 1px solid var(--c-accent); padding: 1.75rem; position: sticky; top: 80px; }
  .guarantee-head { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-accent); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
  .guarantee-score { display: flex; align-items: baseline; gap: 0.15rem; margin-bottom: 0.75rem; }
  .guarantee-num { font-family: var(--font-mono); font-size: 3.5rem; font-weight: 700; letter-spacing: -0.05em; line-height: 1; }
  .guarantee-unit { font-family: var(--font-mono); font-size: 1rem; color: var(--c-text-muted); }
  .guarantee-text { font-size: 0.85rem; color: var(--c-text-muted); line-height: 1.6; margin-bottom: 1.25rem; max-width: 100%; }
  .guarantee-details { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; margin-bottom: 1.25rem; }
  .guarantee-detail { font-family: var(--font-mono); font-size: 0.72rem; color: var(--c-text-muted); display: flex; align-items: center; gap: 0.35rem; }
  .gd-check { color: var(--c-accent); font-weight: 700; }
  .guarantee-footnote { font-family: var(--font-mono); font-size: 0.68rem; color: var(--c-text-dim); line-height: 1.5; border-top: 1px solid var(--c-border); padding-top: 1rem; max-width: 100%; }
  .values-section { background: var(--c-bg); }
  .values-h2 { max-width: 28ch; margin-bottom: 2.5rem; }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--c-border); }
  .value-card { background: var(--c-surface); padding: 2rem 1.75rem; }
  .value-num { font-size: 2.5rem; font-family: var(--font-mono); font-weight: 700; letter-spacing: -0.04em; margin-bottom: 1rem; opacity: 0.4; }
  .value-title { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.65rem; }
  .value-text { font-size: 0.875rem; color: var(--c-text-muted); line-height: 1.7; max-width: 100%; }
  @media (max-width: 860px) {
    .about-hero-inner { grid-template-columns: 1fr; }
    .guarantee-card { position: static; }
    .values-grid { grid-template-columns: 1fr; }
  }
</style>
