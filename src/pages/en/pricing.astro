---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pricing from '../../components/sections/Pricing.astro';
import CTA from '../../components/sections/CTA.astro';
import { useTranslations, useTranslationArray, localizePath } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const ta = useTranslationArray(lang);

const faqKeys = ['1', '2', '3', '4', '5', '6'] as const;

// Comparison table rows: "Feature|Essential|Performance|Signature"
const compareRows = ta('page.pricing.compare.rows' as Parameters<typeof ta>[0]);

const tiers = [
  { name: t('pricing.1.name'), price: '890', personality: 'essential' },
  { name: t('pricing.2.name'), price: '1,890', personality: 'performance', popular: true },
  { name: t('pricing.3.name'), price: '3,900', personality: 'signature' },
] as const;
---

<BaseLayout
  title={t('page.pricing.title')}
  description={t('page.pricing.desc')}
>

  <!-- ─── 1. PAGE HERO — dark split ──────────────────────────── -->
  <section class="ph-section" aria-labelledby="ph-heading">
    <div class="ph-wrap">

      <!-- Left: label + headline + context -->
      <div class="ph-left">
        <div class="ph-eyebrow" aria-hidden="true">
          <span class="ph-dot"></span>
          <span>Pricing</span>
        </div>
        <h1 class="ph-h1" id="ph-heading">
          Every euro justified.<br>Every result guaranteed.
        </h1>
        <p class="ph-sub">
          One-time payment, source code included, contractual Lighthouse score.
          You know exactly what you're getting before you sign.
        </p>
        <div class="ph-cta-row">
          <a href="#pricing" class="ph-btn-primary">See packages</a>
          <a href={localizePath('/contact', lang)} class="ph-btn-ghost">Talk to us</a>
        </div>
      </div>

      <!-- Right: price tower -->
      <div class="ph-right" aria-label="Our three price points">
        <div class="ph-prices">
          <div class="ph-price-item ph-price--essential">
            <span class="ph-price-num" aria-label="890 euros">890</span>
            <span class="ph-price-meta">
              <span class="ph-price-name">{t('pricing.1.name')}</span>
              <span class="ph-price-note">7 days · 5-page site</span>
            </span>
          </div>
          <div class="ph-price-item ph-price--performance">
            <span class="ph-price-num" aria-label="1890 euros">1,890</span>
            <span class="ph-price-meta">
              <span class="ph-price-name">{t('pricing.2.name')} <span class="ph-popular-tag">{t('pricing.popular')}</span></span>
              <span class="ph-price-note">14 days · up to 12 pages</span>
            </span>
          </div>
          <div class="ph-price-item ph-price--signature">
            <span class="ph-price-num" aria-label="3900 euros">3,900</span>
            <span class="ph-price-meta">
              <span class="ph-price-name">{t('pricing.3.name')}</span>
              <span class="ph-price-note">21 days · full identity</span>
            </span>
          </div>
        </div>
        <p class="ph-tax">All prices exclude VAT. Tax applicable based on your status.</p>
      </div>

    </div>
  </section>

  <!-- ─── 2. PRICING CARDS ──────────────────────────────────── -->
  <Pricing lang={lang} compact />

  <!-- ─── 3. COMPARISON TABLE ──────────────────────────────── -->
  <section class="ct-section" aria-labelledby="ct-heading" id="compare">
    <div class="ct-wrap">
      <h2 class="ct-h2 reveal" id="ct-heading">{t('page.pricing.compare.h2' as Parameters<typeof t>[0])}</h2>
      <div class="ct-table-outer">
        <table class="ct-table" role="table">
          <thead>
            <tr class="ct-header-row">
              <th class="ct-th ct-th--feature" scope="col">{t('page.pricing.compare.feature' as Parameters<typeof t>[0])}</th>
              {tiers.map(tier => (
                <th class={`ct-th ct-th--tier ct-th--${tier.personality}`} scope="col">
                  {tier.name}
                  {tier.popular && <span class="ct-popular-badge">{t('pricing.popular')}</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row, i) => {
              const cells = row.split('|');
              const feature = cells[0];
              const vals = cells.slice(1);
              return (
                <tr class={`ct-row ${i % 2 === 0 ? 'ct-row--even' : ''}`}>
                  <td class="ct-td ct-td--feature">{feature}</td>
                  {vals.map((v, vi) => (
                    <td class={`ct-td ct-td--val ct-td--${tiers[vi]?.personality ?? ''}`}>
                      {v === '✓' ? (
                        <span class="ct-check" aria-label="Included">
                          <svg width="14" height="11" viewBox="0 0 14 11" fill="none" aria-hidden="true">
                            <path d="M1.5 5.5L5.5 9.5L12.5 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      ) : v === '—' ? (
                        <span class="ct-dash" aria-label="Not included">—</span>
                      ) : (
                        <span class="ct-val-text">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ─── 4. FAQ ─────────────────────────────────────────────── -->
  <section class="faq-section" aria-labelledby="faq-heading" id="faq">
    <div class="faq-wrap">
      <div class="faq-header reveal">
        <div class="faq-eyebrow" aria-hidden="true">Questions</div>
        <h2 class="faq-h2" id="faq-heading">{t('page.pricing.faq.h2')}</h2>
      </div>

      <div class="faq-list" role="list">
        {faqKeys.map((n, i) => (
          <details
            class={`faq-item reveal reveal-delay-${Math.min(i + 1, 5)}`}
            role="listitem"
          >
            <summary class="faq-q">
              <span class="faq-q-text">
                {t(`page.pricing.faq.${n}.q` as Parameters<typeof t>[0])}
              </span>
              <span class="faq-icon" aria-hidden="true">
                <svg class="faq-icon-svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="faq-icon-v"/>
                  <line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
            </summary>
            <div class="faq-a-wrap">
              <p class="faq-a">
                {t(`page.pricing.faq.${n}.a` as Parameters<typeof t>[0])}
              </p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 5. GUARANTEE ──────────────────────────────────────── -->
  <section class="gu-section" aria-labelledby="gu-heading">
    <div class="gu-wrap">
      <div class="gu-inner reveal">
        <div class="gu-score-badge" aria-label="Lighthouse score guaranteed 95 out of 100">
          <span class="gu-score-num">95</span>
          <span class="gu-score-label">/ 100</span>
        </div>
        <div class="gu-content">
          <div class="gu-eyebrow" aria-hidden="true">{t('page.pricing.guarantee.title' as Parameters<typeof t>[0])}</div>
          <h2 class="gu-h2" id="gu-heading">{t('page.pricing.guarantee.score' as Parameters<typeof t>[0])} — by contract.</h2>
          <p class="gu-text">{t('page.pricing.guarantee.text' as Parameters<typeof t>[0])}</p>
          <a href={localizePath('/contact', lang)} class="gu-cta">
            {t('page.pricing.guarantee.cta' as Parameters<typeof t>[0])} →
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA lang={lang} />

</BaseLayout>

<style>
/* ═══════════════════════════════════════════════════════════
   PAGE HERO — dark split
   ═══════════════════════════════════════════════════════════ */

.ph-section {
  background: #05060A;
  color: #E8EAF2;
  padding-block: calc(72px + 4rem) 5rem;
  overflow: hidden;
}

.ph-wrap {
  width: min(1200px, 100% - 3rem);
  margin-inline: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

/* Left */
.ph-left { display: flex; flex-direction: column; gap: 1.5rem; }

.ph-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--c-accent, #3DFF7A);
}

.ph-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--c-accent, #3DFF7A);
  flex-shrink: 0;
}

.ph-h1 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(2rem, 3.5vw, 3rem);
  letter-spacing: -0.04em;
  line-height: 1.06;
  color: #F0EFE8;
  margin: 0;
}

.ph-sub {
  font-family: var(--font-body);
  font-size: 0.95rem;
  line-height: 1.75;
  color: #6A7490;
  max-width: 44ch;
  margin: 0;
}

.ph-cta-row {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  align-items: center;
}

.ph-btn-primary {
  display: inline-flex;
  align-items: center;
  padding: 0.75rem 1.6rem;
  background: var(--c-accent, #3DFF7A);
  color: #030E07;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.88rem;
  letter-spacing: -0.01em;
  text-decoration: none;
  border-radius: 3px;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.ph-btn-primary:hover { opacity: 0.85; transform: translateY(-1px); }
.ph-btn-primary:focus-visible { outline: 2px solid var(--c-accent, #3DFF7A); outline-offset: 3px; }

.ph-btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: 0.75rem 1.6rem;
  background: transparent;
  color: #8892A8;
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 0.88rem;
  text-decoration: none;
  border: 1px solid #1C2A50;
  border-radius: 3px;
  transition: border-color 0.2s ease, color 0.2s ease;
}
.ph-btn-ghost:hover { border-color: #3A4E70; color: #C0C8D8; }
.ph-btn-ghost:focus-visible { outline: 2px solid var(--c-accent, #3DFF7A); outline-offset: 3px; }

/* Right: price tower */
.ph-right {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
}

.ph-prices {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
}

.ph-price-item {
  display: flex;
  align-items: baseline;
  gap: 1.25rem;
  padding-block: 1rem;
  border-bottom: 1px solid #111825;
  position: relative;
}
.ph-price-item:first-child { border-top: 1px solid #111825; }

.ph-price-num {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.055em;
  line-height: 1;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.ph-price--essential .ph-price-num {
  font-size: clamp(2.4rem, 4vw, 3.4rem);
  color: #707A8C;
}

.ph-price--performance .ph-price-num {
  font-size: clamp(3rem, 5vw, 4.4rem);
  color: var(--c-accent, #3DFF7A);
}

.ph-price--signature .ph-price-num {
  font-size: clamp(3.8rem, 6vw, 5.6rem);
  color: #C9A96E;
}

.ph-price-meta {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.ph-price-name {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.88rem;
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.ph-price--essential .ph-price-name { color: #8090A8; }
.ph-price--performance .ph-price-name { color: #C8E8D8; }
.ph-price--signature .ph-price-name { color: #C9A96E; }

.ph-price-note {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.ph-price--essential .ph-price-note { color: #2E3D58; }
.ph-price--performance .ph-price-note { color: rgba(61,255,122,0.4); }
.ph-price--signature .ph-price-note { color: rgba(201,169,110,0.5); }

.ph-popular-tag {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--c-accent, #3DFF7A);
  color: #030E07;
  padding: 0.1rem 0.4rem;
  border-radius: 2px;
  font-weight: 700;
}

.ph-tax {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.04em;
  color: #2A3450;
  margin: 0;
  max-width: 100%;
}

/* ═══════════════════════════════════════════════════════════
   COMPARISON TABLE
   ═══════════════════════════════════════════════════════════ */

.ct-section {
  background: #030408;
  color: #C8D0E0;
  padding-block: 6rem 5rem;
}

.ct-wrap {
  width: min(1100px, 100% - 3rem);
  margin-inline: auto;
}

.ct-h2 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  letter-spacing: -0.04em;
  color: #E8EAF2;
  margin-bottom: 2.5rem;
  line-height: 1.1;
}

.ct-table-outer {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.ct-table {
  width: 100%;
  min-width: 640px;
  border-collapse: collapse;
  table-layout: fixed;
}

.ct-table thead { position: sticky; top: 0; z-index: 10; }

.ct-header-row {
  background: #06080E;
}

.ct-th {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.82rem;
  letter-spacing: -0.02em;
  padding: 1rem 1.25rem;
  text-align: left;
  border-bottom: 2px solid #1C2A50;
}

.ct-th--feature {
  color: #5B6FA3;
  width: 40%;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-family: var(--font-mono);
  font-weight: 400;
}

.ct-th--essential   { color: #8892A8; width: 20%; }
.ct-th--performance { color: var(--c-accent, #3DFF7A); width: 20%; }
.ct-th--signature   { color: #C9A96E; width: 20%; }

.ct-popular-badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.5rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: var(--c-accent, #3DFF7A);
  color: #030E07;
  padding: 0.12rem 0.35rem;
  border-radius: 2px;
  margin-left: 0.4rem;
  vertical-align: middle;
  font-weight: 700;
}

.ct-td {
  padding: 0.9rem 1.25rem;
  font-size: 0.85rem;
  border-bottom: 1px solid #0D1220;
  vertical-align: middle;
}

.ct-td--feature {
  font-family: var(--font-body);
  color: #8A93A8;
  font-size: 0.8rem;
}

.ct-row--even { background: rgba(255,255,255,0.016); }

.ct-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
}

.ct-td--essential .ct-check   { background: rgba(61,255,122,0.06); color: #3DFF7A; }
.ct-td--performance .ct-check { background: rgba(61,255,122,0.10); color: #3DFF7A; }
.ct-td--signature .ct-check   { background: rgba(201,169,110,0.10); color: #C9A96E; }

.ct-dash {
  color: #222A3A;
  font-size: 1rem;
  display: block;
  text-align: center;
}

.ct-val-text {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.02em;
}

.ct-td--essential .ct-val-text   { color: #6A7490; }
.ct-td--performance .ct-val-text { color: rgba(61,255,122,0.7); }
.ct-td--signature .ct-val-text   { color: #C9A96E; }

/* ═══════════════════════════════════════════════════════════
   FAQ
   ═══════════════════════════════════════════════════════════ */

.faq-section {
  background: #06080E;
  color: #C8D0E0;
  padding-block: 6rem 5.5rem;
  border-top: 1px solid #0D1220;
}

.faq-wrap {
  width: min(780px, 100% - 3rem);
  margin-inline: auto;
}

.faq-header { margin-bottom: 3rem; }

.faq-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--c-accent, #3DFF7A);
  margin-bottom: 0.75rem;
}

.faq-h2 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  letter-spacing: -0.04em;
  line-height: 1.08;
  color: #E8EAF2;
  margin: 0;
}

.faq-list {
  display: flex;
  flex-direction: column;
}

.faq-item {
  border-bottom: 1px solid #0D1525;
}

.faq-item:first-of-type {
  border-top: 1px solid #0D1525;
}

.faq-item > summary { list-style: none; }
.faq-item > summary::-webkit-details-marker { display: none; }

.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  padding-block: 1.4rem;
  cursor: pointer;
  user-select: none;
}

.faq-q:focus-visible {
  outline: 2px solid var(--c-accent, #3DFF7A);
  outline-offset: 2px;
  border-radius: 2px;
}

.faq-q-text {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1rem;
  letter-spacing: -0.025em;
  line-height: 1.35;
  color: #C8D0E0;
  transition: color 0.2s ease;
}

.faq-item[open] .faq-q-text {
  color: #E8EAF2;
}

.faq-icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #0D1525;
  border: 1px solid #1C2A50;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-accent, #3DFF7A);
  transition: background 0.2s ease, border-color 0.2s ease;
}

.faq-item[open] .faq-icon {
  background: rgba(61,255,122,0.08);
  border-color: rgba(61,255,122,0.3);
}

.faq-icon-svg {
  display: block;
  overflow: visible;
}

.faq-icon-v {
  transform-origin: 8px 8px;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.faq-item[open] .faq-icon-v {
  transform: rotate(90deg);
}

.faq-a-wrap {
  overflow: hidden;
  animation: faq-open 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes faq-open {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.faq-a {
  font-family: var(--font-body);
  font-size: 0.9rem;
  line-height: 1.75;
  color: #5B6A88;
  padding-bottom: 1.4rem;
  max-width: 100%;
  margin: 0;
}

/* ═══════════════════════════════════════════════════════════
   GUARANTEE
   ═══════════════════════════════════════════════════════════ */

.gu-section {
  background: #030408;
  padding-block: 5rem;
}

.gu-wrap {
  width: min(900px, 100% - 3rem);
  margin-inline: auto;
}

.gu-inner {
  border: 1px solid rgba(61,255,122,0.18);
  border-radius: 6px;
  padding: 3.5rem;
  display: flex;
  gap: 3rem;
  align-items: center;
  background: linear-gradient(135deg, rgba(61,255,122,0.025) 0%, transparent 60%);
}

.gu-score-badge {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  border: 2px solid var(--c-accent, #3DFF7A);
  background: rgba(61,255,122,0.04);
  gap: 0;
}

.gu-score-num {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 2.4rem;
  letter-spacing: -0.05em;
  color: var(--c-accent, #3DFF7A);
  line-height: 1;
}

.gu-score-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.06em;
  color: rgba(61,255,122,0.45);
}

.gu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.gu-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(61,255,122,0.5);
}

.gu-h2 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  letter-spacing: -0.04em;
  line-height: 1.1;
  color: #E8EAF2;
  margin: 0;
}

.gu-text {
  font-family: var(--font-body);
  font-size: 0.9rem;
  line-height: 1.7;
  color: #5B6A88;
  max-width: 56ch;
  margin: 0;
}

.gu-cta {
  display: inline-flex;
  align-items: center;
  margin-top: 0.5rem;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.88rem;
