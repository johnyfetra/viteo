<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const successEl = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (btn) {
      btn.querySelector('.c-form__submit-text')!.textContent = 'Sending…';
      btn.disabled = true;
    }

    // Simulate send — replace with real endpoint
    await new Promise<void>((resolve) => setTimeout(resolve, 1200));

    // Transition: form → success
    if (form && successEl) {
      form.style.transition = 'opacity 350ms ease';
      form.style.opacity = '0';
      setTimeout(() => {
        form.hidden = true;
        form.style.opacity = '';
        successEl.hidden = false;
      }, 350);
    }
  });

  // Scroll reveal for .reveal-left and .reveal-right
  // (.reveal elements are handled by BaseLayout's global observer)
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (motionOk) {
    const leftRight = document.querySelectorAll<HTMLElement>('.reveal-left, .reveal-right');
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add('visible');
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.06, rootMargin: '0px 0px -30px 0px' }
    );
    leftRight.forEach((el) => obs.observe(el));
  } else {
    document.querySelectorAll<HTMLElement>('.reveal-left, .reveal-right').forEach((el) => {
      el.classList.add('visible');
    });
  }
</script>
