---
import { useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero s-hero" aria-label={lang === 'fr' ? 'Accueil' : 'Home'}>
  <!-- Subtle grid background behind text side only -->
  <div class="grid-bg" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- Left: Text column -->
    <div class="hero-text">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t('hero.eyebrow')}
      </div>

      <h1 class="hero-h1">
        <span class="hero-h1-line">{t('hero.h1a')}</span>
        <span class="hero-h1-score" aria-label={t('hero.h1b')} id="hero-score-text">
          <span class="score-counter" id="score-num" aria-hidden="true">0</span>
          <span class="score-slash" aria-hidden="true">&thinsp;/&thinsp;100.</span>
        </span>
        <span class="hero-h1-line hero-h1-accent">{t('hero.h1c')}</span>
      </h1>

      <p class="hero-sub">{t('hero.sub')}</p>

      <div class="hero-actions">
        <a href={localizePath(lang === 'fr' ? '/tarifs' : '/pricing', lang)} class="btn btn-primary btn-lg">
          {t('hero.cta1')}
        </a>
        <a href={localizePath('/contact', lang)} class="btn btn-ghost btn-lg">
          {t('hero.cta2')}
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="hero-trust">
        <div class="trust-item">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>{lang === 'fr' ? 'Score garanti contractuellement' : 'Score guaranteed by contract'}</span>
        </div>
        <div class="trust-item">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>{lang === 'fr' ? 'Livraison en 7 à 21 jours' : 'Delivery in 7 to 21 days'}</span>
        </div>
        <div class="trust-item">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>{lang === 'fr' ? 'Code source fourni' : 'Source code provided'}</span>
        </div>
      </div>
    </div>

    <!-- Right: Portrait -->
    <div class="hero-portrait-wrap">
      <div class="hero-portrait-inner" id="portrait-inner">
        <img
          src="/hero-portrait.png"
          alt={lang === 'fr' ? 'Portrait du fondateur — Viteo Studio, studio web haute performance' : 'Founder portrait — Viteo Studio, high-performance web studio'}
          class="hero-portrait-img"
          width="900"
          height="1100"
          fetchpriority="high"
          decoding="async"
        />
        <!-- Green accent overlay -->
        <div class="portrait-overlay-green" aria-hidden="true"></div>
        <!-- Ambient glow behind the portrait -->
        <div class="portrait-glow" aria-hidden="true"></div>
      </div>

      <!-- Lighthouse score badge -->
      <div class="score-badge" aria-hidden="true">
        <span class="score-badge-icon">⬡</span>
        <span class="score-badge-label">Lighthouse</span>
        <span class="score-badge-num">99</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    width: 45%;
    background-image:
      linear-gradient(rgba(28, 42, 80, 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgba(28, 42, 80, 0.35) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 80% at 30% 40%, black 10%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 45fr 55fr;
    min-height: 100svh;
  }

  /* ── Text column ── */
  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px clamp(1.5rem, 4vw, 3.5rem) 5rem clamp(1.25rem, 4vw, 2.5rem);
    max-width: 640px;
    margin-left: auto;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.04em;
  }

  .hero-h1-line {
    display: block;
    color: #E0E8FF;
  }

  .hero-h1-accent {
    color: #3DFF7A;
  }

  .hero-h1-score {
    display: flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: clamp(3rem, 6vw, 5.6rem);
    font-weight: 700;
    color: #3DFF7A;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .score-slash {
    font-size: 0.6em;
    color: rgba(224, 232, 255, 0.35);
    font-weight: 400;
  }

  .hero-sub {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    color: rgba(224, 232, 255, 0.55);
    max-width: 44ch;
    line-height: 1.78;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .hero-trust {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(224, 232, 255, 0.4);
    letter-spacing: 0.02em;
  }

  .trust-check {
    color: #3DFF7A;
    font-weight: 700;
    font-size: 0.75rem;
  }

  /* ── Portrait column ── */
  .hero-portrait-wrap {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .hero-portrait-inner {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    will-change: transform, opacity;
  }

  .hero-portrait-img {
    display: block;
    max-height: 88svh;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  /* Subtle green tint overlay */
  .portrait-overlay-green {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 50% 30%,
      rgba(61, 255, 122, 0.05) 0%,
      rgba(61, 255, 122, 0.02) 50%,
      transparent 80%
    );
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Ambient glow */
  .portrait-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 45% at 75% 60%, rgba(43, 82, 255, 0.07) 0%, transparent 65%),
      radial-gradient(ellipse 40% 35% at 20% 70%, rgba(255, 32, 64, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  /* Lighthouse score badge */
  .score-badge {
    position: absolute;
    bottom: clamp(3rem, 6vw, 5rem);
    left: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(5, 6, 10, 0.72);
    border: 1px solid rgba(61, 255, 122, 0.28);
    padding: 0.45rem 0.9rem;
    backdrop-filter: blur(8px);
    animation: badge-float 4s ease-in-out infinite alternate;
  }

  .score-badge-icon {
    color: #3DFF7A;
    font-size: 0.9rem;
    line-height: 1;
  }

  .score-badge-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(224, 232, 255, 0.5);
  }

  .score-badge-num {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    color: #3DFF7A;
    letter-spacing: -0.02em;
  }

  @keyframes badge-float {
    from { transform: translateY(0px); }
    to   { transform: translateY(-6px); }
  }

  /* ── Scroll indicator ── */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 22.5%; /* center of left column */
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, #3DFF7A, transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.25; transform: scaleY(0.5); transform-origin: top; }
    50%       { opacity: 0.9; transform: scaleY(1); }
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-rows: 45svh 1fr;
      min-height: 100svh;
    }

    .hero-portrait-wrap {
      grid-row: 1;
      min-height: 45svh;
    }

    .hero-portrait-img {
      max-height: 44svh;
    }

    .hero-text {
      grid-row: 2;
      max-width: 100%;
      margin-left: 0;
      padding: 2.5rem clamp(1.25rem, 4vw, 2.5rem) 5rem;
      text-align: center;
      align-items: center;
    }

    .hero-sub { max-width: 52ch; text-align: center; }
    .hero-actions { justify-content: center; }
    .hero-trust { align-items: center; }

    .score-badge {
      bottom: 1rem;
      left: 1rem;
    }

    .grid-bg { width: 100%; }

    .scroll-indicator {
      left: 50%;
    }
  }

  @media (max-width: 480px) {
    .hero-h1 {
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }

    .hero-h1-score {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .score-badge { animation: none; }
    .scroll-line { animation: none; opacity: 0.4; }
  }

  /* ── Light theme ── */
  :global([data-theme="light"]) .hero {
    background-color: #F4F3EF;
    color: #0F0D0B;
  }
  :global([data-theme="light"]) .grid-bg {
    background-image:
      linear-gradient(rgba(15,13,11,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,13,11,0.05) 1px, transparent 1px);
  }
  :global([data-theme="light"]) .hero-h1-line {
    color: #0F0D0B;
  }
  :global([data-theme="light"]) .hero-h1-accent {
    color: #007A34;
  }
  :global([data-theme="light"]) .hero-h1-score {
    color: #007A34;
  }
  :global([data-theme="light"]) .score-slash {
    color: rgba(15,13,11,0.2);
  }
  :global([data-theme="light"]) .hero-sub {
    color: rgba(15,13,11,0.55);
  }
  :global([data-theme="light"]) .trust-item {
    color: rgba(15,13,11,0.4);
  }
  :global([data-theme="light"]) .trust-check {
    color: #007A34;
  }
  :global([data-theme="light"]) .portrait-overlay-green {
    opacity: 0.3;
  }
  :global([data-theme="light"]) .portrait-glow {
    opacity: 0.3;
  }
  :global([data-theme="light"]) .score-badge {
    background: rgba(244,243,239,0.90);
    border-color: rgba(0,122,52,0.25);
  }
  :global([data-theme="light"]) .score-badge-icon { color: #007A34; }
  :global([data-theme="light"]) .score-badge-label { color: rgba(15,13,11,0.45); }
  :global([data-theme="light"]) .score-badge-num { color: #007A34; }
  :global([data-theme="light"]) .scroll-line {
    background: linear-gradient(to bottom, #007A34, transparent);
  }
</style>

<script>
(function () {
  'use strict';

  // ── Score counter in headline ──
  const scoreEl = document.getElementById('score-num') as HTMLElement | null;
  const duration = 1800;
  const startDelay = 400;

  function easeOut(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  function runScoreCounter() {
    const start = performance.now();
    function tick(now: number) {
      const raw = Math.min((now - start) / duration, 1);
      const e = easeOut(raw);
      if (scoreEl) scoreEl.textContent = String(Math.round(e * 100));
      if (raw < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  setTimeout(runScoreCounter, startDelay);

  // ── Portrait : parallax souris + dezoom/fade au scroll ──
  const portrait = document.getElementById('portrait-inner') as HTMLElement | null;
  if (!portrait) return;

  const portraitWrap = portrait.parentElement as HTMLElement;
  const section = portrait.closest('section') as HTMLElement;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;
  let scrollProgress = 0;
  let rafId = 0;

  // Mouse parallax
  section?.addEventListener('mousemove', (e: Event) => {
    const me = e as MouseEvent;
    const rect = section.getBoundingClientRect();
    const nx = (me.clientX - rect.left) / rect.width - 0.5;
    const ny = (me.clientY - rect.top) / rect.height - 0.5;
    targetX = nx * 10;
    targetY = ny * 6;
  });

  // Scroll tracking
  function onScroll() {
    const rect = section.getBoundingClientRect();
    scrollProgress = Math.max(0, Math.min(1, -rect.top / rect.height));
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  function animate() {
    currentX += (targetX - currentX) * 0.06;
    currentY += (targetY - currentY) * 0.06;

    // Dezoom : scale de 1.0 → 0.80 sur toute la hauteur du hero
    const scale = 1 - scrollProgress * 0.20;
    // Fade : disparaît à 65% du scroll
    const opacity = Math.max(0, 1 - scrollProgress * 1.6);

    portrait.style.transform = `translate(${currentX}px, ${currentY}px) scale(${scale})`;
    portraitWrap.style.opacity = String(opacity);

    rafId = requestAnimationFrame(animate);
  }

  rafId = requestAnimationFrame(animate);
})();
</script>
