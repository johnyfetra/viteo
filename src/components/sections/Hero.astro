---
import { useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero s-hero" aria-label={lang === 'fr' ? 'Accueil' : 'Home'}>
  <!-- Subtle grid background behind text side only -->
  <div class="grid-bg" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- Left: Text column -->
    <div class="hero-text">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t('hero.eyebrow')}
      </div>

      <h1 class="hero-h1">
        <span class="hero-h1-line">{t('hero.h1a')}</span>
        <span class="hero-h1-score" aria-label={t('hero.h1b')} id="hero-score-text">
          <span class="score-counter" id="score-num" aria-hidden="true">0</span>
          <span class="score-slash" aria-hidden="true">&thinsp;/&thinsp;100.</span>
        </span>
        <span class="hero-h1-line hero-h1-accent">{t('hero.h1c')}</span>
      </h1>

      <p class="hero-sub">{t('hero.sub')}</p>

      <div class="hero-actions">
        <a href={localizePath(lang === 'fr' ? '/tarifs' : '/pricing', lang)} class="btn btn-primary btn-lg">
          {t('hero.cta1')}
        </a>
        <a href={localizePath('/contact', lang)} class="btn btn-ghost btn-lg">
          {t('hero.cta2')}
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="hero-trust">
        <div class="trust-item">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>{lang === 'fr' ? 'Score garanti contractuellement' : 'Score guaranteed by contract'}</span>
        </div>
        <div class="trust-item">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>{lang === 'fr' ? 'Livraison en 7 à 21 jours' : 'Delivery in 7 to 21 days'}</span>
        </div>
        <div class="trust-item">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>{lang === 'fr' ? 'Code source fourni' : 'Source code provided'}</span>
        </div>
      </div>
    </div>

    <!-- Right: Face canvas -->
    <div class="hero-canvas-wrap">
      <canvas
        id="face-canvas"
        aria-label={lang === 'fr' ? 'Portrait Viteo Studio, éclairage RGB' : 'Viteo Studio portrait, RGB lighting'}
        role="img"
      ></canvas>

      <!-- Lighthouse score badge -->
      <div class="score-badge" aria-hidden="true">
        <span class="score-badge-icon">⬡</span>
        <span class="score-badge-label">Lighthouse</span>
        <span class="score-badge-num">99</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    width: 45%;
    background-image:
      linear-gradient(rgba(28, 42, 80, 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgba(28, 42, 80, 0.35) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 80% at 30% 40%, black 10%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 45fr 55fr;
    min-height: 100svh;
  }

  /* ── Text column ── */
  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px clamp(1.5rem, 4vw, 3.5rem) 5rem clamp(1.25rem, 4vw, 2.5rem);
    max-width: 640px;
    margin-left: auto;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.04em;
  }

  .hero-h1-line {
    display: block;
    color: #E0E8FF;
  }

  .hero-h1-accent {
    color: #3DFF7A;
  }

  .hero-h1-score {
    display: flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: clamp(3rem, 6vw, 5.6rem);
    font-weight: 700;
    color: #3DFF7A;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .score-slash {
    font-size: 0.6em;
    color: rgba(224, 232, 255, 0.35);
    font-weight: 400;
  }

  .hero-sub {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    color: rgba(224, 232, 255, 0.55);
    max-width: 44ch;
    line-height: 1.78;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .hero-trust {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(224, 232, 255, 0.4);
    letter-spacing: 0.02em;
  }

  .trust-check {
    color: #3DFF7A;
    font-weight: 700;
    font-size: 0.75rem;
  }

  /* ── Canvas column ── */
  .hero-canvas-wrap {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  #face-canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100svh;
  }

  /* Lighthouse score badge */
  .score-badge {
    position: absolute;
    bottom: clamp(3rem, 6vw, 5rem);
    left: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(5, 6, 10, 0.72);
    border: 1px solid rgba(61, 255, 122, 0.28);
    padding: 0.45rem 0.9rem;
    backdrop-filter: blur(8px);
    animation: badge-float 4s ease-in-out infinite alternate;
  }

  .score-badge-icon {
    color: #3DFF7A;
    font-size: 0.9rem;
    line-height: 1;
  }

  .score-badge-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(224, 232, 255, 0.5);
  }

  .score-badge-num {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    color: #3DFF7A;
    letter-spacing: -0.02em;
  }

  @keyframes badge-float {
    from { transform: translateY(0px); }
    to   { transform: translateY(-6px); }
  }

  /* ── Scroll indicator ── */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 22.5%; /* center of left column */
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, #3DFF7A, transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.25; transform: scaleY(0.5); transform-origin: top; }
    50%       { opacity: 0.9; transform: scaleY(1); }
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-rows: 40svh 1fr;
      min-height: 100svh;
    }

    .hero-canvas-wrap {
      grid-row: 1;
      min-height: 40svh;
    }

    #face-canvas {
      min-height: 40svh;
    }

    .hero-text {
      grid-row: 2;
      max-width: 100%;
      margin-left: 0;
      padding: 2.5rem clamp(1.25rem, 4vw, 2.5rem) 5rem;
      text-align: center;
      align-items: center;
    }

    .hero-sub { max-width: 52ch; text-align: center; }
    .hero-actions { justify-content: center; }
    .hero-trust { align-items: center; }

    .score-badge {
      bottom: 1rem;
      left: 1rem;
    }

    .grid-bg { width: 100%; }

    .scroll-indicator {
      left: 50%;
    }
  }

  @media (max-width: 480px) {
    .hero-h1 {
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }

    .hero-h1-score {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .score-badge { animation: none; }
    .scroll-line { animation: none; opacity: 0.4; }
  }
</style>

<script>
(function () {
  'use strict';

  // ── Score counter in headline ──
  const scoreEl = document.getElementById('score-num') as HTMLElement | null;
  const duration = 1800;
  const startDelay = 400;

  function easeOut(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  function runScoreCounter() {
    const start = performance.now();
    function tick(now: number) {
      const raw = Math.min((now - start) / duration, 1);
      const e = easeOut(raw);
      if (scoreEl) scoreEl.textContent = String(Math.round(e * 100));
      if (raw < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  setTimeout(runScoreCounter, startDelay);

  // ── Face canvas ──
  const canvas = document.getElementById('face-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let W = 0, H = 0;
  let mouseX = 0.5, mouseY = 0.5;
  let targetMouseX = 0.5, targetMouseY = 0.5;
  let rafId = 0;
  let startTime = 0;

  const BG = '#05060A';

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas!.getBoundingClientRect();
    W = rect.width;
    H = rect.height;
    canvas!.width = Math.round(W * dpr);
    canvas!.height = Math.round(H * dpr);
    ctx!.scale(dpr, dpr);
  }

  function buildFacePath(fcx: number, fcy: number, fs: number): Path2D {
    const p = new Path2D();
    // Head oval
    p.moveTo(fcx, fcy - fs * 0.72);
    p.bezierCurveTo(fcx + fs * 0.50, fcy - fs * 0.72, fcx + fs * 0.53, fcy - fs * 0.10, fcx + fs * 0.53, fcy + fs * 0.18);
    // Right jaw
    p.bezierCurveTo(fcx + fs * 0.53, fcy + fs * 0.62, fcx + fs * 0.36, fcy + fs * 0.72, fcx, fcy + fs * 0.72);
    // Left jaw
    p.bezierCurveTo(fcx - fs * 0.36, fcy + fs * 0.72, fcx - fs * 0.53, fcy + fs * 0.62, fcx - fs * 0.53, fcy + fs * 0.18);
    // Left side
    p.bezierCurveTo(fcx - fs * 0.53, fcy - fs * 0.10, fcx - fs * 0.50, fcy - fs * 0.72, fcx, fcy - fs * 0.72);
    p.closePath();
    return p;
  }

  function buildNeckPath(fcx: number, fcy: number, fs: number): Path2D {
    const p = new Path2D();
    const neckTop = fcy + fs * 0.72;
    const neckBot = neckTop + fs * 0.38;
    const nw = fs * 0.16;
    p.rect(fcx - nw, neckTop, nw * 2, fs * 0.38 + 2);
    return p;
  }

  function buildShoulderPath(fcx: number, fcy: number, fs: number): Path2D {
    const p = new Path2D();
    const neckTop = fcy + fs * 0.72;
    const neckBot = neckTop + fs * 0.38;
    const nw = fs * 0.16;
    // From neck-base, bezier out to shoulders, down to canvas bottom
    p.moveTo(fcx - nw, neckBot);
    p.bezierCurveTo(fcx - nw * 1.4, neckBot + fs * 0.1, fcx - fs * 0.9, neckBot + fs * 0.3, fcx - fs * 1.15, H + 20);
    p.lineTo(fcx + fs * 1.15, H + 20);
    p.bezierCurveTo(fcx + fs * 0.9, neckBot + fs * 0.3, fcx + nw * 1.4, neckBot + fs * 0.1, fcx + nw, neckBot);
    p.closePath();
    return p;
  }

  function buildSilhouette(fcx: number, fcy: number, fs: number): Path2D {
    // Combine face + neck + shoulders as one clipping shape
    const p = new Path2D();

    // Head
    p.moveTo(fcx, fcy - fs * 0.72);
    p.bezierCurveTo(fcx + fs * 0.50, fcy - fs * 0.72, fcx + fs * 0.53, fcy - fs * 0.10, fcx + fs * 0.53, fcy + fs * 0.18);
    p.bezierCurveTo(fcx + fs * 0.53, fcy + fs * 0.62, fcx + fs * 0.36, fcy + fs * 0.72, fcx, fcy + fs * 0.72);
    p.bezierCurveTo(fcx - fs * 0.36, fcy + fs * 0.72, fcx - fs * 0.53, fcy + fs * 0.62, fcx - fs * 0.53, fcy + fs * 0.18);
    p.bezierCurveTo(fcx - fs * 0.53, fcy - fs * 0.10, fcx - fs * 0.50, fcy - fs * 0.72, fcx, fcy - fs * 0.72);
    p.closePath();

    // Neck + shoulders as a separate sub-path (additive)
    const neckTop = fcy + fs * 0.72;
    const neckBot = neckTop + fs * 0.38;
    const nw = fs * 0.16;
    p.moveTo(fcx - nw, neckTop);
    p.lineTo(fcx + nw, neckTop);
    p.lineTo(fcx + nw, neckBot);
    p.bezierCurveTo(fcx + nw * 1.4, neckBot + fs * 0.1, fcx + fs * 0.9, neckBot + fs * 0.3, fcx + fs * 1.15, H + 20);
    p.lineTo(fcx - fs * 1.15, H + 20);
    p.bezierCurveTo(fcx - fs * 0.9, neckBot + fs * 0.3, fcx - nw * 1.4, neckBot + fs * 0.1, fcx - nw, neckBot);
    p.closePath();

    return p;
  }

  function drawFrame(timestamp: number) {
    if (!ctx || !canvas) return;

    if (startTime === 0) startTime = timestamp;
    const t = (timestamp - startTime) / 1000; // seconds

    // Smooth mouse lerp
    mouseX += (targetMouseX - mouseX) * 0.04;
    mouseY += (targetMouseY - mouseY) * 0.04;

    // Face center and scale
    const fcx = W * 0.46;
    const fcy = H * 0.42;
    const fs = Math.min(W, H) * 0.42;

    // ── 1. Background ──
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = BG;
    ctx.fillRect(0, 0, W, H);

    // ── 2. Draw face silhouette (dark base) ──
    const silhouette = buildSilhouette(fcx, fcy, fs);
    ctx.save();
    ctx.fillStyle = '#0E0F14';
    ctx.fill(silhouette, 'nonzero');
    ctx.restore();

    // ── 3. RGB lights — clipped to silhouette ──
    // Each light breathes with a gentle sin offset
    const breathR = 0.82 + Math.sin(t * 0.41) * 0.12;
    const breathG = 0.78 + Math.sin(t * 0.37 + 1.1) * 0.14;
    const breathB = 0.80 + Math.sin(t * 0.44 + 2.3) * 0.11;

    // Green light follows mouse subtly
    const gOffX = (mouseX - 0.5) * fs * 0.22;
    const gOffY = (mouseY - 0.5) * fs * 0.18;

    ctx.save();
    ctx.clip(silhouette, 'nonzero');
    ctx.globalCompositeOperation = 'screen';

    // Red — bottom-left
    const rGrad = ctx.createRadialGradient(
      fcx - fs * 0.62, fcy + fs * 0.55, 0,
      fcx - fs * 0.62, fcy + fs * 0.55, fs * 1.18
    );
    rGrad.addColorStop(0, `rgba(255, 32, 64, ${0.88 * breathR})`);
    rGrad.addColorStop(0.45, `rgba(255, 32, 64, ${0.42 * breathR})`);
    rGrad.addColorStop(1, 'rgba(255, 32, 64, 0)');
    ctx.fillStyle = rGrad;
    ctx.fillRect(0, 0, W, H);

    // Green — top-center (mouse-following)
    const gGrad = ctx.createRadialGradient(
      fcx + gOffX, fcy - fs * 0.60 + gOffY, 0,
      fcx + gOffX, fcy - fs * 0.60 + gOffY, fs * 1.22
    );
    gGrad.addColorStop(0, `rgba(0, 255, 120, ${0.85 * breathG})`);
    gGrad.addColorStop(0.4, `rgba(0, 255, 120, ${0.38 * breathG})`);
    gGrad.addColorStop(1, 'rgba(0, 255, 120, 0)');
    ctx.fillStyle = gGrad;
    ctx.fillRect(0, 0, W, H);

    // Blue — right side
    const bGrad = ctx.createRadialGradient(
      fcx + fs * 0.72, fcy + fs * 0.05, 0,
      fcx + fs * 0.72, fcy + fs * 0.05, fs * 1.20
    );
    bGrad.addColorStop(0, `rgba(43, 82, 255, ${0.88 * breathB})`);
    bGrad.addColorStop(0.42, `rgba(43, 82, 255, ${0.40 * breathB})`);
    bGrad.addColorStop(1, 'rgba(43, 82, 255, 0)');
    ctx.fillStyle = bGrad;
    ctx.fillRect(0, 0, W, H);

    ctx.restore();

    // ── 4. Eye glow spots ──
    ctx.save();
    ctx.clip(silhouette, 'nonzero');
    ctx.globalCompositeOperation = 'screen';

    const eyeY = fcy - fs * 0.12;
    const eyeSpread = fs * 0.22;

    // Left eye
    const le = ctx.createRadialGradient(fcx - eyeSpread, eyeY, 0, fcx - eyeSpread, eyeY, fs * 0.14);
    le.addColorStop(0, 'rgba(255,255,255,0.55)');
    le.addColorStop(0.5, 'rgba(255,255,255,0.10)');
    le.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = le;
    ctx.fillRect(0, 0, W, H);

    // Right eye
    const re = ctx.createRadialGradient(fcx + eyeSpread, eyeY, 0, fcx + eyeSpread, eyeY, fs * 0.14);
    re.addColorStop(0, 'rgba(255,255,255,0.55)');
    re.addColorStop(0.5, 'rgba(255,255,255,0.10)');
    re.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = re;
    ctx.fillRect(0, 0, W, H);

    ctx.restore();

    // ── 5. Edge vignette on silhouette ──
    ctx.save();
    ctx.clip(silhouette, 'nonzero');
    ctx.globalCompositeOperation = 'multiply';
    const vig = ctx.createRadialGradient(fcx, fcy, fs * 0.18, fcx, fcy, fs * 1.0);
    vig.addColorStop(0, 'rgba(255,255,255,1)');
    vig.addColorStop(0.55, 'rgba(180,180,180,1)');
    vig.addColorStop(1, 'rgba(20,20,20,1)');
    ctx.fillStyle = vig;
    ctx.fillRect(0, 0, W, H);
    ctx.restore();

    // ── 6. Dark halo around silhouette (atmospheric bleed) ──
    ctx.save();
    ctx.globalCompositeOperation = 'source-over';
    // Very soft outer glow: draw silhouette-shaped shadow bleed
    ctx.shadowColor = 'rgba(0,200,100,0.07)';
    ctx.shadowBlur = 48;
    ctx.fillStyle = 'transparent';
    ctx.fill(silhouette, 'nonzero');
    ctx.restore();

    rafId = requestAnimationFrame(drawFrame);
  }

  // Mouse tracking
  canvas.closest('section')?.addEventListener('mousemove', (e: Event) => {
    const me = e as MouseEvent;
    const rect = canvas.getBoundingClientRect();
    targetMouseX = (me.clientX - rect.left) / rect.width;
    targetMouseY = (me.clientY - rect.top) / rect.height;
  });

  // Resize observer
  const ro = new ResizeObserver(() => {
    cancelAnimationFrame(rafId);
    resize();
    rafId = requestAnimationFrame(drawFrame);
  });
  ro.observe(canvas);

  // Start
  resize();
  rafId = requestAnimationFrame(drawFrame);

  // Pause when off-screen
  const io = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      rafId = requestAnimationFrame(drawFrame);
    } else {
      cancelAnimationFrame(rafId);
    }
  }, { threshold: 0 });
  io.observe(canvas);

  // Reduced motion: stop animation, draw single still frame
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (prefersReduced.matches) {
    cancelAnimationFrame(rafId);
    resize();
    // Draw a single static frame at t=0 with no breathing
    const fcx = W * 0.46;
    const fcy = H * 0.42;
    const fs = Math.min(W, H) * 0.42;
    ctx.fillStyle = BG;
    ctx.fillRect(0, 0, W, H);
    const sil = buildSilhouette(fcx, fcy, fs);
    ctx.fillStyle = '#0E0F14';
    ctx.fill(sil, 'nonzero');
    ctx.save();
    ctx.clip(sil, 'nonzero');
    ctx.globalCompositeOperation = 'screen';
    const rg = ctx.createRadialGradient(fcx - fs * 0.62, fcy + fs * 0.55, 0, fcx - fs * 0.62, fcy + fs * 0.55, fs * 1.18);
    rg.addColorStop(0, 'rgba(255,32,64,0.82)');
    rg.addColorStop(1, 'rgba(255,32,64,0)');
    ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);
    const gg = ctx.createRadialGradient(fcx, fcy - fs * 0.60, 0, fcx, fcy - fs * 0.60, fs * 1.22);
    gg.addColorStop(0, 'rgba(0,255,120,0.80)');
    gg.addColorStop(1, 'rgba(0,255,120,0)');
    ctx.fillStyle = gg; ctx.fillRect(0, 0, W, H);
    const bg2 = ctx.createRadialGradient(fcx + fs * 0.72, fcy + fs * 0.05, 0, fcx + fs * 0.72, fcy + fs * 0.05, fs * 1.20);
    bg2.addColorStop(0, 'rgba(43,82,255,0.82)');
    bg2.addColorStop(1, 'rgba(43,82,255,0)');
    ctx.fillStyle = bg2; ctx.fillRect(0, 0, W, H);
    ctx.restore();
  }
})();
</script>
