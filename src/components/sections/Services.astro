---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  { key: '1', icon: '⚡', variant: 'perf',      watermark: '95+',  span: 'wide' },
  { key: '2', icon: '🔍', variant: 'seo',       watermark: 'SEO',  span: 'narrow' },
  { key: '3', icon: '✦',  variant: 'design',    watermark: '∞',    span: 'narrow' },
  { key: '4', icon: '⊕',  variant: 'cms',       watermark: 'CMS',  span: 'narrow' },
  { key: '5', icon: '⊙',  variant: 'rgpd',      watermark: 'RGPD', span: 'wide' },
  { key: '6', icon: '◷',  variant: 'delivery',  watermark: '7j',   span: 'narrow' },
] as const;
---

<section class="s-services services-section" id="services">
  <div class="svc-container">

    <!-- Header -->
    <header class="svc-header reveal">
      <div class="svc-eyebrow">
        <span class="svc-eyebrow-dot" aria-hidden="true"></span>
        {t('services.eyebrow')}
      </div>
      <h2 class="svc-h2">{t('services.h2')}</h2>
      <p class="svc-intro">{t('services.intro')}</p>
    </header>

    <!-- Bento Grid -->
    <div class="svc-bento" role="list">
      {services.map(({ key, icon, variant, watermark, span }, i) => (
        <article
          class={`svc-card svc-card--${variant} svc-card--${span} reveal`}
          style={`--reveal-delay: ${i * 80}ms`}
          role="listitem"
        >
          <!-- Watermark -->
          <span class="svc-watermark" aria-hidden="true">{watermark}</span>

          <!-- Icon -->
          <div class="svc-icon" aria-hidden="true">{icon}</div>

          <!-- Content -->
          <div class="svc-body">
            <h3 class="svc-title">{t(`services.${key}.title` as Parameters<typeof t>[0])}</h3>
            <p class="svc-text">{t(`services.${key}.text` as Parameters<typeof t>[0])}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /* ─── Section shell ─────────────────────────────────────── */
  .services-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    transition: background-color 0.35s ease, color 0.35s ease;
  }

  .svc-container {
    width: min(100%, 1160px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  /* ─── Header ────────────────────────────────────────────── */
  .svc-header {
    max-width: 680px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .svc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin-bottom: 1.1rem;
  }

  .svc-eyebrow-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
    flex-shrink: 0;
  }

  .svc-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--c-text);
    margin-bottom: 1rem;
  }

  .svc-intro {
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    color: var(--c-text-muted);
    line-height: 1.75;
    max-width: 62ch;
  }

  /* ─── Bento Grid ────────────────────────────────────────── */
  .svc-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: 16px;
    overflow: hidden;
  }

  /*
    Row 1: card1 (wide=2), card2 (narrow=1), card3 (narrow=1)
    Row 2: card4 (narrow=1), card5 (wide=2), card6 (narrow=1)
  */
  .svc-card--wide   { grid-column: span 2; }
  .svc-card--narrow { grid-column: span 1; }

  /* ─── Card base ─────────────────────────────────────────── */
  .svc-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--c-bg);
    transition:
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 200ms ease,
      background-color 0.35s ease,
      background 200ms ease;
    cursor: default;
    min-height: 220px;
  }

  .svc-card:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: -2px;
  }

  /* ─── Watermark ─────────────────────────────────────────── */
  .svc-watermark {
    position: absolute;
    right: -0.1em;
    bottom: -0.2em;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  /* ─── Icon ──────────────────────────────────────────────── */
  .svc-icon {
    font-size: 2rem;
    line-height: 1;
    display: block;
    position: relative;
    z-index: 1;
  }

  /* ─── Body ──────────────────────────────────────────────── */
  .svc-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .svc-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--c-text);
    line-height: 1.2;
  }

  .svc-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--c-text-muted);
    line-height: 1.7;
  }

  /* ════════════════════════════════════════════════════════
     CARD VARIANTS — unique treatments per card
  ════════════════════════════════════════════════════════ */

  /* Card 1 — Performance (wide, Row 1) */
  .svc-card--perf {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--c-r) 6%, transparent) 0%, transparent 55%),
      var(--c-bg);
  }
  .svc-card--perf .svc-watermark {
    color: var(--c-r);
    opacity: 0.08;
  }
  .svc-card--perf .svc-icon { filter: drop-shadow(0 0 8px color-mix(in srgb, var(--c-r) 60%, transparent)); }
  .svc-card--perf:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--c-r) 14%, transparent);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--c-r) 10%, transparent) 0%, transparent 55%),
      var(--c-surface);
  }
  .svc-card--perf:hover .svc-watermark { opacity: 0.14; transform: scale(1.04); }

  /* Card 2 — SEO (narrow) */
  .svc-card--seo {
    background:
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--c-b) 5%, transparent) 0px,
        color-mix(in srgb, var(--c-b) 5%, transparent) 1px,
        transparent 1px,
        transparent 22px
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--c-b) 5%, transparent) 0px,
        color-mix(in srgb, var(--c-b) 5%, transparent) 1px,
        transparent 1px,
        transparent 22px
      ),
      var(--c-bg);
  }
  .svc-card--seo .svc-watermark {
    color: var(--c-b);
    opacity: 0.07;
  }
  .svc-card--seo:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--c-b) 14%, transparent);
  }
  .svc-card--seo:hover .svc-watermark { opacity: 0.14; transform: scale(1.04); }

  /* Card 3 — Design (narrow) */
  .svc-card--design {
    background: var(--c-bg);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--c-accent) 8%, transparent),
      inset 40px 40px 80px color-mix(in srgb, var(--c-accent) 4%, transparent),
      inset -20px -20px 60px color-mix(in srgb, var(--c-g) 3%, transparent);
  }
  .svc-card--design .svc-watermark {
    color: var(--c-accent);
    opacity: 0.07;
  }
  .svc-card--design:hover {
    transform: translateY(-4px);
    box-shadow:
      0 12px 40px color-mix(in srgb, var(--c-accent) 14%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--c-accent) 16%, transparent),
      inset 40px 40px 80px color-mix(in srgb, var(--c-accent) 7%, transparent);
  }
  .svc-card--design:hover .svc-watermark { opacity: 0.12; transform: scale(1.04); }

  /* Card 4 — Autonomy/CMS (narrow) */
  .svc-card--cms {
    background:
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--c-b) 4%, transparent) 0px,
        color-mix(in srgb, var(--c-b) 4%, transparent) 1px,
        transparent 1px,
        transparent 28px
      ),
      var(--c-bg);
  }
  .svc-card--cms .svc-watermark {
    color: var(--c-b);
    opacity: 0.06;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }
  .svc-card--cms:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--c-b) 14%, transparent);
  }
  .svc-card--cms:hover .svc-watermark { opacity: 0.12; transform: scale(1.04); }

  /* Card 5 — RGPD (wide, Row 2) */
  .svc-card--rgpd {
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, color-mix(in srgb, var(--c-accent) 5%, transparent), transparent),
      var(--c-bg);
  }
  .svc-card--rgpd .svc-watermark {
    color: var(--c-accent);
    opacity: 0.06;
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: -0.03em;
  }
  .svc-card--rgpd:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--c-accent) 14%, transparent);
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, color-mix(in srgb, var(--c-accent) 9%, transparent), transparent),
      var(--c-surface);
  }
  .svc-card--rgpd:hover .svc-watermark { opacity: 0.11; transform: scale(1.04); }

  /* Card 6 — Delivery (narrow) */
  .svc-card--delivery {
    background: var(--c-bg);
    /* Geometric diagonal stripes */
    background-image:
      repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--c-accent) 4%, transparent) 0px,
        color-mix(in srgb, var(--c-accent) 4%, transparent) 1px,
        transparent 1px,
        transparent 16px
      );
  }
  .svc-card--delivery .svc-watermark {
    color: var(--c-accent);
    opacity: 0.07;
  }
  .svc-card--delivery:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--c-accent) 14%, transparent);
  }
  .svc-card--delivery:hover .svc-watermark { opacity: 0.14; transform: scale(1.04); }

  /* ─── Light theme overrides ─────────────────────────────── */
  :global([data-theme="light"]) .svc-bento {
    background: #D8D5CE;
    border-color: #D8D5CE;
  }

  /* Cards: white base + keep color personality via subtle tints */
  :global([data-theme="light"]) .svc-card {
    border-top: 2px solid transparent;
  }

  :global([data-theme="light"]) .svc-card--perf {
    background: linear-gradient(145deg, rgba(204,0,32,0.04) 0%, transparent 60%), #FFFFFF;
    border-top-color: #CC0020;
  }
  :global([data-theme="light"]) .svc-card--seo {
    background:
      repeating-linear-gradient(0deg, rgba(26,63,204,0.04) 0px, rgba(26,63,204,0.04) 1px, transparent 1px, transparent 22px),
      repeating-linear-gradient(90deg, rgba(26,63,204,0.04) 0px, rgba(26,63,204,0.04) 1px, transparent 1px, transparent 22px),
      #FFFFFF;
    border-top-color: #1A3FCC;
  }
  :global([data-theme="light"]) .svc-card--design {
    background: linear-gradient(145deg, rgba(0,122,52,0.04) 0%, transparent 60%), #FFFFFF;
    border-top-color: #007A34;
  }
  :global([data-theme="light"]) .svc-card--cms {
    background:
      repeating-linear-gradient(90deg, rgba(26,63,204,0.03) 0px, rgba(26,63,204,0.03) 1px, transparent 1px, transparent 28px),
      #FFFFFF;
    border-top-color: #1A3FCC;
  }
  :global([data-theme="light"]) .svc-card--rgpd {
    background: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(0,122,52,0.05), transparent), #FFFFFF;
    border-top-color: #007A34;
  }
  :global([data-theme="light"]) .svc-card--delivery {
    background:
      repeating-linear-gradient(-45deg, rgba(0,122,52,0.03) 0px, rgba(0,122,52,0.03) 1px, transparent 1px, transparent 16px),
      #FFFFFF;
    border-top-color: #007A34;
  }

  /* Watermarks: slightly more visible on white */
  :global([data-theme="light"]) .svc-card--perf .svc-watermark    { color: #CC0020; opacity: 0.07; }
  :global([data-theme="light"]) .svc-card--seo .svc-watermark     { color: #1A3FCC; opacity: 0.06; }
  :global([data-theme="light"]) .svc-card--design .svc-watermark  { color: #007A34; opacity: 0.07; }
  :global([data-theme="light"]) .svc-card--cms .svc-watermark     { color: #1A3FCC; opacity: 0.06; }
  :global([data-theme="light"]) .svc-card--rgpd .svc-watermark    { color: #007A34; opacity: 0.06; }
  :global([data-theme="light"]) .svc-card--delivery .svc-watermark { color: #007A34; opacity: 0.07; }

  :global([data-theme="light"]) .svc-card:hover {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.09), 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  /* ─── Reveal animation ──────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  /* ─── Responsive ─────────────────────────────────────────── */

  /* Tablet — 2 columns, all cards equal */
  @media (max-width: 900px) {
    .svc-bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .svc-card--wide,
    .svc-card--narrow {
      grid-column: span 1;
    }
  }

  /* Mobile — 1 column */
  @media (max-width: 560px) {
    .svc-bento {
      grid-template-columns: 1fr;
      border-radius: 12px;
    }
    .svc-card--wide,
    .svc-card--narrow {
      grid-column: span 1;
    }
    .svc-card {
      min-height: 180px;
    }
  }
</style>

<script>
  // Stagger reveal on scroll
  const revealEls = document.querySelectorAll<HTMLElement>('.services-section .reveal');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  revealEls.forEach((el) => observer.observe(el));
</script>
