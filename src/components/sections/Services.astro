---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  { key: '1', icon: '⚡', color: 'accent' },
  { key: '2', icon: '🔍', color: 'blue' },
  { key: '3', icon: '✦', color: 'accent' },
  { key: '4', icon: '⊕', color: 'blue' },
  { key: '5', icon: '⊙', color: 'accent' },
  { key: '6', icon: '◷', color: 'blue' },
] as const;
---

<section class="section services-section" id="services">
  <div class="container">
    <div class="services-header">
      <div class="eyebrow reveal">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t('services.eyebrow')}
      </div>
      <h2 class="services-h2 reveal">{t('services.h2')}</h2>
      <p class="services-intro reveal">{t('services.intro')}</p>
    </div>

    <div class="services-grid">
      {services.map(({ key, icon, color }, i) => (
        <article class={`service-card reveal reveal-delay-${i % 3 + 1}`}>
          <div class={`service-icon service-icon-${color}`} aria-hidden="true">{icon}</div>
          <h3 class="service-title">{t(`services.${key}.title` as Parameters<typeof t>[0])}</h3>
          <p class="service-text">{t(`services.${key}.text` as Parameters<typeof t>[0])}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }

  .services-header {
    max-width: 720px;
    margin-bottom: 3.5rem;
  }

  .services-h2 {
    margin-bottom: 1rem;
    max-width: 26ch;
  }

  .services-intro {
    font-size: 1.05rem;
    color: var(--c-text-muted);
    line-height: 1.75;
    max-width: 62ch;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-border);
  }

  .service-card {
    background: var(--c-bg);
    padding: 2rem 1.75rem;
    transition: background var(--duration-base);
  }

  [data-theme="light"] .service-card {
    background: var(--c-surface);
  }

  .service-card:hover {
    background: var(--c-surface-2);
  }

  .service-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    display: block;
    line-height: 1;
  }

  .service-icon-accent { color: var(--c-accent); }
  .service-icon-blue   { color: var(--c-blue); }

  .service-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin-bottom: 0.65rem;
  }

  .service-text {
    font-size: 0.875rem;
    color: var(--c-text-muted);
    line-height: 1.7;
    max-width: 100%;
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
