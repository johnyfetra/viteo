---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = ['1', '2', '3', '4'] as const;
---

<section class="section process-section" id="process">
  <div class="container">
    <div class="eyebrow reveal">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      {t('process.eyebrow')}
    </div>
    <h2 class="process-h2 reveal">{t('process.h2')}</h2>

    <ol class="process-steps" aria-label={lang === 'fr' ? 'Étapes du processus' : 'Process steps'}>
      {steps.map((n, i) => (
        <li class={`process-step reveal reveal-delay-${i + 1}`}>
          <div class="step-num" aria-hidden="true">{t(`process.${n}.num` as Parameters<typeof t>[0])}</div>
          <div class="step-body">
            <div class="step-connector" aria-hidden="true"></div>
            <h3 class="step-title">{t(`process.${n}.title` as Parameters<typeof t>[0])}</h3>
            <p class="step-text">{t(`process.${n}.text` as Parameters<typeof t>[0])}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-section {
    position: relative;
    overflow: hidden;
  }

  .process-h2 {
    max-width: 30ch;
    margin-bottom: 3.5rem;
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    list-style: none;
    counter-reset: steps;
    position: relative;
  }

  /* Horizontal connector line */
  .process-steps::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: calc(0.5rem + 1px);
    right: calc(0.5rem + 1px);
    height: 1px;
    background: linear-gradient(to right, var(--c-accent), var(--c-border), var(--c-border), transparent);
    z-index: 0;
  }

  .process-step {
    padding: 0 1.5rem 0 0;
    position: relative;
    z-index: 1;
  }

  .process-step:last-child {
    padding-right: 0;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--c-accent);
    background: var(--c-bg);
    border: 1px solid var(--c-accent);
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 2;
    transition: background var(--duration-slow);
  }

  [data-theme="light"] .step-num {
    background: var(--c-surface);
  }

  .step-body {
    position: relative;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin-bottom: 0.65rem;
  }

  .step-text {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    line-height: 1.7;
    max-width: 100%;
  }

  @media (max-width: 860px) {
    .process-steps {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .process-steps::before {
      display: none;
    }

    .process-step {
      padding: 0;
    }
  }

  @media (max-width: 480px) {
    .process-steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
