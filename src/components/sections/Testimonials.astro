---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const testimonials = ['1', '2', '3'] as const;

const scores = [99, 100, 98];
---

<section class="section testimonials-section" id="testimonials">
  <div class="container">
    <div class="testimonials-header">
      <div class="eyebrow reveal">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t('testimonials.eyebrow')}
      </div>
      <h2 class="testimonials-h2 reveal">{t('testimonials.h2')}</h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((n, i) => (
        <figure class={`testimonial-card reveal reveal-delay-${i + 1}`}>
          <!-- Score indicator -->
          <div class="testimonial-score" aria-label={`Score Lighthouse ${scores[i]}/100`}>
            <span class="score-num metric-value">{scores[i]}</span>
            <span class="score-denom">/100</span>
          </div>

          <blockquote>
            <p class="testimonial-text">{t(`testimonials.${n}.text` as Parameters<typeof t>[0])}</p>
          </blockquote>

          <figcaption class="testimonial-author">
            <div class="author-avatar" aria-hidden="true">
              {t(`testimonials.${n}.name` as Parameters<typeof t>[0]).split(' ').map(w => w[0]).join('')}
            </div>
            <div class="author-info">
              <div class="author-name">{t(`testimonials.${n}.name` as Parameters<typeof t>[0])}</div>
              <div class="author-role">{t(`testimonials.${n}.role` as Parameters<typeof t>[0])}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }

  .testimonials-header {
    margin-bottom: 3rem;
  }

  .testimonials-h2 {
    max-width: 40ch;
    margin-top: 0.25rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .testimonial-card {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: border-color var(--duration-base);
    margin: 0;
  }

  [data-theme="light"] .testimonial-card {
    background: var(--c-surface);
  }

  .testimonial-card:hover {
    border-color: var(--c-text-dim);
  }

  /* Score */
  .testimonial-score {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
  }

  .score-num {
    font-size: 2rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .score-denom {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--c-text-muted);
    font-weight: 400;
  }

  /* Quote */
  .testimonial-text {
    font-size: 0.9rem;
    color: var(--c-text-muted);
    line-height: 1.75;
    font-style: italic;
    flex: 1;
    max-width: 100%;
  }

  /* Author */
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    background: var(--c-accent-2);
    border: 1px solid rgba(61, 255, 122, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-accent);
    flex-shrink: 0;
    letter-spacing: 0;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin-bottom: 0.1rem;
  }

  .author-role {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--c-text-muted);
    letter-spacing: 0.04em;
  }

  @media (max-width: 860px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 561px) and (max-width: 860px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
