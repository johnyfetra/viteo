---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const testimonials = ['1', '2', '3'] as const;

const scores = [99, 100, 98];

// Per-card color identity tied to Viteo's RGB system
const avatarColors = [
  { bg: 'rgba(61,255,122,0.12)',  border: 'rgba(61,255,122,0.3)',  text: '#3DFF7A', label: 'green' },
  { bg: 'rgba(43,82,255,0.15)',   border: 'rgba(43,82,255,0.3)',   text: '#6B8FFF', label: 'blue' },
  { bg: 'rgba(255,32,64,0.12)',   border: 'rgba(255,32,64,0.3)',   text: '#FF6070', label: 'red'  },
];

const scoreBadgeColors = [
  { bg: 'rgba(61,255,122,0.08)',  border: 'rgba(61,255,122,0.2)',  text: '#3DFF7A' },
  { bg: 'rgba(61,255,122,0.12)', border: 'rgba(61,255,122,0.35)', text: '#3DFF7A' },
  { bg: 'rgba(61,255,122,0.08)',  border: 'rgba(61,255,122,0.2)',  text: '#3DFF7A' },
];
---

<section class="s-testimonials testi-section" id="testimonials">
  <!-- Decorative large opening quote — background element -->
  <div class="testi-bg-quote" aria-hidden="true">&ldquo;</div>

  <div class="testi-container">
    <!-- Header -->
    <header class="testi-header reveal">
      <div class="testi-eyebrow">
        <span class="testi-eyebrow-dot" aria-hidden="true"></span>
        {t('testimonials.eyebrow')}
      </div>
      <h2 class="testi-h2">{t('testimonials.h2')}</h2>
    </header>

    <!-- Cards grid -->
    <div class="testi-grid">
      {testimonials.map((n, i) => (
        <figure
          class={`testi-card reveal reveal-delay-${i + 1}`}
          style={`--avatar-bg:${avatarColors[i].bg};--avatar-border:${avatarColors[i].border};--avatar-text:${avatarColors[i].text};--badge-bg:${scoreBadgeColors[i].bg};--badge-border:${scoreBadgeColors[i].border};--badge-text:${scoreBadgeColors[i].text};`}
          data-card-index={i}
        >
          <!-- Stars row — animated in via JS on scroll -->
          <div class="testi-stars" aria-label="5 étoiles sur 5" role="img">
            {[0,1,2,3,4].map((s) => (
              <svg
                class="testi-star"
                style={`--star-delay:${s * 0.1}s`}
                width="16" height="16" viewBox="0 0 16 16"
                fill="none" xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path d="M8 1.5L9.854 5.757L14.5 6.382L11.25 9.493L12.118 14.116L8 11.875L3.882 14.116L4.75 9.493L1.5 6.382L6.146 5.757L8 1.5Z" fill="#3DFF7A"/>
              </svg>
            ))}
          </div>

          <!-- Quote text -->
          <blockquote class="testi-blockquote">
            <p class="testi-quote-text">{t(`testimonials.${n}.text` as Parameters<typeof t>[0])}</p>
          </blockquote>

          <!-- Divider -->
          <div class="testi-rule" aria-hidden="true"></div>

          <!-- Author + Lighthouse badge row -->
          <figcaption class="testi-footer">
            <div class="testi-author">
              <div class="testi-avatar" aria-hidden="true">
                {t(`testimonials.${n}.name` as Parameters<typeof t>[0]).split(' ').map((w: string) => w[0]).join('')}
              </div>
              <div class="testi-author-info">
                <div class="testi-author-name">{t(`testimonials.${n}.name` as Parameters<typeof t>[0])}</div>
                <div class="testi-author-role">{t(`testimonials.${n}.role` as Parameters<typeof t>[0])}</div>
              </div>
            </div>
            <div
              class="testi-score-badge"
              aria-label={`Score Lighthouse ${scores[i]}/100`}
            >
              <span class="testi-score-icon" aria-hidden="true">
                <!-- Lighthouse lighthouse icon — simplified -->
                <svg width="10" height="12" viewBox="0 0 10 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 0L10 3V9L5 12L0 9V3L5 0Z" fill="currentColor" opacity="0.7"/>
                  <path d="M5 2.5L7.5 4V8L5 9.5L2.5 8V4L5 2.5Z" fill="currentColor"/>
                </svg>
              </span>
              <span class="testi-score-num">{scores[i]}</span>
              <span class="testi-score-denom">/100</span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* ─── Section shell — always dark, intentional contrast island ──────── */
  .testi-section {
    /* s-testimonials sets background: #060A0E — we reinforce it */
    background: #060A0E;
    color: #D8DFF0;
    position: relative;
    padding: clamp(5rem, 8vw, 8rem) 0 clamp(5rem, 8vw, 7rem);
    overflow: hidden;
    /* Override any theme-level light-mode surface changes */
  }

  :global([data-theme="light"]) .testi-section {
    background: #060A0E;
    color: #D8DFF0;
  }

  /* ─── Decorative background quotation mark ──────────────────────────── */
  .testi-bg-quote {
    position: absolute;
    top: -0.5rem;
    left: clamp(1rem, 4vw, 5rem);
    font-size: clamp(8rem, 14vw, 16rem);
    font-family: var(--font-display, 'Space Grotesk Variable', sans-serif);
    font-weight: 800;
    line-height: 1;
    color: #D8DFF0;
    opacity: 0.045;
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.05em;
  }

  /* ─── Layout container ──────────────────────────────────────────────── */
  .testi-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 5vw, 3rem);
  }

  /* ─── Header ────────────────────────────────────────────────────────── */
  .testi-header {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .testi-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5B6FA3;
    margin-bottom: 0.9rem;
  }

  .testi-eyebrow-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3DFF7A;
    flex-shrink: 0;
  }

  .testi-h2 {
    font-family: var(--font-display, 'Space Grotesk Variable', sans-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #E0E8FF;
    max-width: 36ch;
    margin: 0;
  }

  /* ─── Cards grid ────────────────────────────────────────────────────── */
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    position: relative;
  }

  /* Subtle vertical connector lines between cards */
  .testi-grid::before,
  .testi-grid::after {
    content: '';
    position: absolute;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(61,255,122,0.12) 30%, rgba(61,255,122,0.12) 70%, transparent);
    pointer-events: none;
  }

  .testi-grid::before {
    left: calc(33.333% - 0.5px);
  }

  .testi-grid::after {
    left: calc(66.666% - 0.5px);
  }

  /* ─── Single card ───────────────────────────────────────────────────── */
  .testi-card {
    background: #0C1220;
    border: 1px solid #1C2A50;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    transition: transform 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
    position: relative;
    z-index: 1;
  }

  .testi-card:hover {
    transform: translateY(-3px);
    border-color: rgba(61,255,122,0.2);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4), 0 0 0 1px rgba(61,255,122,0.06);
  }

  /* ─── Stars ─────────────────────────────────────────────────────────── */
  .testi-stars {
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }

  .testi-star {
    opacity: 0;
    transform: scale(0.6) translateY(4px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    transition-delay: var(--star-delay, 0s);
    flex-shrink: 0;
  }

  /* Stars become visible when card enters the viewport (JS adds .stars-visible) */
  .testi-card.stars-visible .testi-star {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* ─── Quote text ─────────────────────────────────────────────────────── */
  .testi-blockquote {
    margin: 0;
    flex: 1;
  }

  .testi-quote-text {
    font-family: var(--font-body, 'Inter Variable', sans-serif);
    font-size: 1.05rem;
    line-height: 1.8;
    color: #C4CFEA;
    font-style: italic;
    margin: 0;
  }

  /* ─── Horizontal rule ───────────────────────────────────────────────── */
  .testi-rule {
    height: 1px;
    background: linear-gradient(to right, transparent, #1C2A50 20%, #1C2A50 80%, transparent);
  }

  /* ─── Footer row: author + badge ────────────────────────────────────── */
  .testi-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* ─── Author ─────────────────────────────────────────────────────────── */
  .testi-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .testi-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--avatar-bg);
    border: 1px solid var(--avatar-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display, 'Space Grotesk Variable', sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--avatar-text);
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  .testi-author-info {
    min-width: 0;
  }

  .testi-author-name {
    font-family: var(--font-display, 'Space Grotesk Variable', sans-serif);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #E0E8FF;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .testi-author-role {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    color: #5B6FA3;
    margin-top: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ─── Lighthouse score badge ─────────────────────────────────────────── */
  .testi-score-badge {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .testi-score-icon {
    display: inline-flex;
    align-items: center;
    color: var(--badge-text);
    margin-right: 0.2rem;
    position: relative;
    top: 1px;
  }

  .testi-score-num {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1rem;
    font-weight: 700;
    color: var(--badge-text);
    line-height: 1;
  }

  .testi-score-denom {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.65rem;
    color: #5B6FA3;
    font-weight: 400;
    align-self: flex-end;
    padding-bottom: 0.05rem;
  }

  /* ─── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .testi-grid {
      grid-template-columns: 1fr;
    }

    .testi-grid::before,
    .testi-grid::after {
      display: none;
    }
  }

  @media (min-width: 580px) and (max-width: 900px) {
    .testi-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .testi-grid::before {
      display: block;
      left: calc(50% - 0.5px);
    }

    .testi-grid::after {
      display: none;
    }
  }

  /* ─── Reduced motion ─────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .testi-star {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .testi-card {
      transition: none;
    }
  }
</style>

<script>
  // Star animation: trigger when each card enters the viewport
  (function () {
    const cards = document.querySelectorAll<HTMLElement>('.testi-card');

    if (!cards.length) return;

    // Respect reduced motion — reveal stars immediately
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      cards.forEach(card => card.classList.add('stars-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('stars-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );

    cards.forEach(card => observer.observe(card));
  })();
</script>
