---
import { useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-glow" aria-hidden="true"></div>

  <div class="container cta-inner">
    <div class="cta-content">
      <div class="eyebrow reveal">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t('cta.eyebrow')}
      </div>
      <h2 class="cta-h2 reveal" id="cta-heading">{t('cta.h2')}</h2>
      <p class="cta-sub reveal">{t('cta.sub')}</p>
      <div class="cta-actions reveal">
        <a href={localizePath('/contact', lang)} class="btn btn-primary btn-lg">
          {t('cta.btn1')}
        </a>
        <a href={localizePath(lang === 'fr' ? '/tarifs' : '/pricing', lang)} class="btn btn-ghost btn-lg">
          {t('cta.btn2')}
        </a>
      </div>
    </div>

    <!-- Decorative metrics -->
    <div class="cta-metrics" aria-hidden="true">
      <div class="cta-metric">
        <span class="cta-metric-val metric-value">100</span>
        <span class="cta-metric-label">Performance</span>
      </div>
      <div class="cta-metric">
        <span class="cta-metric-val metric-value">100</span>
        <span class="cta-metric-label">SEO</span>
      </div>
      <div class="cta-metric">
        <span class="cta-metric-val metric-value">7j</span>
        <span class="cta-metric-label">{lang === 'fr' ? 'Livraison' : 'Delivery'}</span>
      </div>
      <div class="cta-metric">
        <span class="cta-metric-val metric-value">0€</span>
        <span class="cta-metric-label">{lang === 'fr' ? '1er échange' : 'First call'}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--space-2xl);
    position: relative;
    overflow: hidden;
    background: var(--c-bg);
  }

  .cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 30% 60%, var(--c-accent-glow), transparent 65%);
    pointer-events: none;
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 5rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .cta-h2 {
    max-width: 30ch;
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .cta-sub {
    font-size: 1rem;
    color: var(--c-text-muted);
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 50ch;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Metrics decorative */
  .cta-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
  }

  .cta-metric {
    background: var(--c-surface);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cta-metric-val {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .cta-metric-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  @media (max-width: 860px) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .cta-metrics {
      max-width: 400px;
    }
  }
</style>
