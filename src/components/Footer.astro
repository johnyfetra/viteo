---
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { key: 'nav.services', path: '/services' },
  { key: 'nav.pricing',  path: lang === 'fr' ? '/tarifs' : '/pricing' },
  { key: 'nav.about',    path: lang === 'fr' ? '/a-propos' : '/about' },
  { key: 'nav.contact',  path: '/contact' },
] as const;
---

<footer class="footer">
  <div class="container footer-inner">
    <!-- Brand -->
    <div class="footer-brand">
      <a href={`/${lang}/`} class="footer-logo" aria-label="Viteo Studio">
        <span class="footer-logo-mark" aria-hidden="true">●</span>
        <span class="footer-logo-name">Viteo</span>
      </a>
      <p class="footer-tagline">{t('footer.tagline')}</p>

      <!-- Performance badge -->
      <div class="footer-badges">
        <span class="badge badge-green">
          <span aria-hidden="true">⚡</span>
          Lighthouse 100/100
        </span>
        <span class="badge badge-blue">
          <span aria-hidden="true">🌱</span>
          Astro + Vercel
        </span>
      </div>
    </div>

    <!-- Links -->
    <nav aria-label={lang === 'fr' ? 'Navigation du pied de page' : 'Footer navigation'}>
      <p class="footer-col-title">{t('footer.links')}</p>
      <ul class="footer-links">
        {nav.map(({ key, path }) => (
          <li>
            <a href={localizePath(path, lang)} class="footer-link">
              {t(key as Parameters<typeof t>[0])}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Contact -->
    <div class="footer-contact">
      <p class="footer-col-title">Contact</p>
      <ul class="footer-contact-list">
        <li>
          <a href="mailto:hello@viteo.studio" class="footer-link footer-email">
            hello@viteo.studio
          </a>
        </li>
        <li class="footer-contact-item">
          <span class="footer-contact-icon" aria-hidden="true">↩</span>
          {t('contact.info.resp')}
        </li>
        <li class="footer-contact-item">
          <span class="footer-contact-icon" aria-hidden="true">☎</span>
          {t('contact.info.call')}
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span class="footer-copy">{t('footer.copy')}</span>
      <div class="footer-bottom-links">
        <a href={localizePath('/mentions-legales', lang)} class="footer-bottom-link">
          {t('footer.legal')}
        </a>
        <a href={localizePath('/confidentialite', lang)} class="footer-bottom-link">
          {t('footer.privacy')}
        </a>
        <span class="footer-made">{t('footer.made')}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 4rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
    text-decoration: none;
  }

  .footer-logo-mark {
    color: var(--c-accent);
    font-size: 0.9rem;
  }

  .footer-logo-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--c-text);
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    margin-bottom: 1.5rem;
    max-width: 30ch;
    line-height: 1.6;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Columns */
  .footer-col-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-dim);
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-link:hover {
    color: var(--c-text);
  }

  .footer-email {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--c-accent);
  }

  .footer-email:hover {
    opacity: 0.8;
  }

  .footer-contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-contact-item {
    font-size: 0.82rem;
    color: var(--c-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-contact-icon {
    font-size: 0.9rem;
    color: var(--c-text-dim);
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid var(--c-border-dim);
    padding-block: 1.25rem;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy,
  .footer-made {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--c-text-dim);
    letter-spacing: 0.04em;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-bottom-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--c-text-dim);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-bottom-link:hover {
    color: var(--c-text-muted);
  }

  @media (max-width: 860px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
