---
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { key: 'nav.services', path: '/services' },
  { key: 'nav.pricing',  path: lang === 'fr' ? '/tarifs' : '/pricing' },
  { key: 'nav.about',    path: lang === 'fr' ? '/a-propos' : '/about' },
  { key: 'nav.contact',  path: '/contact' },
] as const;

const socials = [
  { label: 'LinkedIn', href: 'https://linkedin.com/company/viteo-studio' },
  { label: 'GitHub',   href: 'https://github.com/viteo-studio' },
  { label: 'Twitter',  href: 'https://twitter.com/viteo_studio' },
];
---

<footer class="ft" aria-label={lang === 'fr' ? 'Pied de page' : 'Footer'}>

  <!-- Fine grid atmosphere -->
  <div class="ft-grid" aria-hidden="true"></div>

  <!-- Watermark: large VITEO behind content -->
  <span class="ft-watermark" aria-hidden="true">VITEO</span>

  <!-- Top border accent -->
  <div class="ft-top-border" aria-hidden="true"></div>

  <!-- Main grid -->
  <div class="ft-body">

    <!-- Column 1: Brand -->
    <div class="ft-brand ft-reveal ft-reveal-left">
      <a href={`/${lang}/`} class="ft-logo" aria-label="Viteo Studio — accueil">
        <span class="ft-logo-dot" aria-hidden="true"></span>
        <span class="ft-logo-name">Viteo</span>
        <span class="ft-logo-studio">.studio</span>
      </a>

      <!-- RGB pulse dots -->
      <div class="ft-rgb" aria-hidden="true">
        <span class="ft-rgb-r"></span>
        <span class="ft-rgb-g"></span>
        <span class="ft-rgb-b"></span>
      </div>

      <p class="ft-tagline">{t('footer.tagline')}</p>

      <ul class="ft-socials" aria-label={lang === 'fr' ? 'Réseaux sociaux' : 'Social links'}>
        {socials.map(({ label, href }) => (
          <li>
            <a href={href} class="ft-social-link" target="_blank" rel="noopener noreferrer">
              <span class="ft-social-dash" aria-hidden="true">—</span>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 2: Navigation -->
    <nav class="ft-col ft-reveal ft-reveal-up ft-reveal-d1" aria-label={lang === 'fr' ? 'Navigation du pied de page' : 'Footer navigation'}>
      <p class="ft-col-label">{t('footer.links')}</p>
      <ul class="ft-nav">
        {nav.map(({ key, path }) => (
          <li>
            <a href={localizePath(path, lang)} class="ft-nav-link">
              {t(key as Parameters<typeof t>[0])}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Column 3: Contact -->
    <div class="ft-col ft-contact-col ft-reveal ft-reveal-right">
      <p class="ft-col-label">Contact</p>
      <ul class="ft-contact">
        <li>
          <a href="mailto:hello@viteo.studio" class="ft-email">
            hello@viteo.studio
          </a>
        </li>
        <li class="ft-contact-meta">
          <span class="ft-contact-icon" aria-hidden="true">◎</span>
          Paris, France
        </li>
        <li class="ft-contact-meta">
          <span class="ft-contact-icon" aria-hidden="true">↩</span>
          {t('contact.info.resp')}
        </li>
      </ul>
    </div>

  </div>

  <!-- Divider -->
  <div class="ft-divider ft-reveal ft-reveal-up ft-reveal-d2" aria-hidden="true"></div>

  <!-- Bottom bar -->
  <div class="ft-bottom ft-reveal ft-reveal-up ft-reveal-d3">
    <span class="ft-copy">{t('footer.copy')}</span>
    <div class="ft-bottom-links">
      <a href={localizePath('/mentions-legales', lang)} class="ft-bottom-link">
        {t('footer.legal')}
      </a>
      <span class="ft-bottom-sep" aria-hidden="true">·</span>
      <a href={localizePath('/confidentialite', lang)} class="ft-bottom-link">
        {t('footer.privacy')}
      </a>
      <span class="ft-bottom-sep" aria-hidden="true">·</span>
      <span class="ft-made">{t('footer.made')}</span>
    </div>
  </div>

</footer>

<style>
/* ── Root ──────────────────────────────────────────────────── */
.ft {
  position: relative;
  background-color: #030408;
  color: #E0E8FF;
  overflow: hidden;
  padding-left: clamp(1.5rem, 5vw, 4rem);
  padding-right: clamp(1.5rem, 5vw, 4rem);
}

/* ── Fine grid ─────────────────────────────────────────────── */
.ft-grid {
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(0deg,   transparent, transparent 59px, rgba(28, 42, 80, 0.12) 59px, rgba(28, 42, 80, 0.12) 60px),
    repeating-linear-gradient(90deg,  transparent, transparent 59px, rgba(28, 42, 80, 0.12) 59px, rgba(28, 42, 80, 0.12) 60px);
  pointer-events: none;
  z-index: 0;
}

/* ── Watermark ──────────────────────────────────────────────── */
.ft-watermark {
  pointer-events: none;
  user-select: none;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-display, 'Space Grotesk Variable', sans-serif);
  font-size: clamp(8rem, 18vw, 22rem);
  font-weight: 900;
  letter-spacing: 0.12em;
  color: #E0E8FF;
  opacity: 0.025;
  line-height: 1;
  white-space: nowrap;
  z-index: 0;
}

/* ── Top border accent ─────────────────────────────────────── */
.ft-top-border {
  position: relative;
  z-index: 1;
  height: 1px;
  background: linear-gradient(to right, transparent, #1C2A50 20%, #3DFF7A44 50%, #1C2A50 80%, transparent);
  margin-bottom: 0;
}

/* ── Main grid ─────────────────────────────────────────────── */
.ft-body {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 2fr 1fr 1.5fr;
  gap: 0 clamp(2rem, 5vw, 5rem);
  padding-top: clamp(3rem, 6vw, 5rem);
  padding-bottom: clamp(2.5rem, 4vw, 4rem);
}

/* ── Brand column ──────────────────────────────────────────── */
.ft-logo {
  display: inline-flex;
  align-items: baseline;
  gap: 0.3rem;
  text-decoration: none;
  margin-bottom: 1rem;
}

.ft-logo-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: #3DFF7A;
  flex-shrink: 0;
  align-self: center;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.ft-logo:hover .ft-logo-dot {
  transform: scale(1.5);
  box-shadow: 0 0 10px rgba(61, 255, 122, 0.53);
}

.ft-logo-name {
  font-family: var(--font-display, 'Space Grotesk Variable', sans-serif);
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: #E0E8FF;
  transition: color 0.2s;
}

.ft-logo-studio {
  font-family: var(--font-mono, ui-monospace);
  font-size: 0.7rem;
  letter-spacing: 0.05em;
  color: #5B6FA3;
  transition: color 0.2s;
}

.ft-logo:hover .ft-logo-name { color: #ffffff; }
.ft-logo:hover .ft-logo-studio { color: #8B9FC8; }

/* RGB dots */
.ft-rgb {
  display: flex;
  gap: 5px;
  align-items: center;
  margin-bottom: 1.25rem;
  margin-top: 0.2rem;
}

.ft-rgb-r,
.ft-rgb-g,
.ft-rgb-b {
  display: block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  opacity: 0.55;
  flex-shrink: 0;
}

.ft-rgb-r { background-color: #FF2040; }
.ft-rgb-g { background-color: #3DFF7A; }
.ft-rgb-b { background-color: #2B52FF; }

.ft-brand:hover .ft-rgb-r { animation: rgb-pulse 0.6s ease-out; }
.ft-brand:hover .ft-rgb-g { animation: rgb-pulse 0.6s ease-out 0.08s; }
.ft-brand:hover .ft-rgb-b { animation: rgb-pulse 0.6s ease-out 0.16s; }

@keyframes rgb-pulse {
  0%   { opacity: 0.55; transform: scale(1); }
  40%  { opacity: 1;    transform: scale(1.6); }
  100% { opacity: 0.55; transform: scale(1); }
}

.ft-tagline {
  font-family: var(--font-body, 'Inter Variable', sans-serif);
  font-size: 0.85rem;
  color: #5B6FA3;
  line-height: 1.65;
  max-width: 28ch;
  margin-bottom: 1.5rem;
}

/* Social links */
.ft-socials {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.ft-social-link {
  font-family: var(--font-mono, ui-monospace);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #2E3D60;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: color 0.2s;
}

.ft-social-dash {
  display: inline-block;
  width: 0;
  overflow: hidden;
  transition: width 0.2s ease;
}

.ft-social-link:hover {
  color: #3DFF7A;
}

.ft-social-link:hover .ft-social-dash {
  width: 1rem;
}

.ft-social-link:focus-visible {
  outline: 1px solid #3DFF7A;
  outline-offset: 3px;
  border-radius: 2px;
}

/* ── Shared column styles ──────────────────────────────────── */
.ft-col-label {
  font-family: var(--font-mono, ui-monospace);
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #2E3D60;
  margin-bottom: 1.2rem;
}

/* ── Nav column ────────────────────────────────────────────── */
.ft-nav {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.ft-nav-link {
  font-family: var(--font-body, 'Inter Variable', sans-serif);
  font-size: 0.875rem;
  color: #5B6FA3;
  text-decoration: none;
  transition: color 0.18s, padding-left 0.2s;
  display: inline-block;
}

.ft-nav-link:hover {
  color: #E0E8FF;
  padding-left: 0.5rem;
}

.ft-nav-link:focus-visible {
  outline: 1px solid #3DFF7A;
  outline-offset: 3px;
  border-radius: 2px;
}

/* ── Contact column ────────────────────────────────────────── */
.ft-contact {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.ft-email {
  font-family: var(--font-mono, ui-monospace);
  font-size: 0.82rem;
  color: #3DFF7A;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: opacity 0.18s;
}

.ft-email:hover { opacity: 0.75; }

.ft-email:focus-visible {
  outline: 1px solid #3DFF7A;
  outline-offset: 3px;
  border-radius: 2px;
}

.ft-contact-meta {
  font-family: var(--font-body, 'Inter Variable', sans-serif);
  font-size: 0.82rem;
  color: #5B6FA3;
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.ft-contact-icon {
  font-size: 0.75rem;
  color: #2E3D60;
  line-height: 1;
  flex-shrink: 0;
}

/* ── Divider ───────────────────────────────────────────────── */
.ft-divider {
  position: relative;
  z-index: 1;
  height: 1px;
  background-color: #1C2A50;
}

/* ── Bottom bar ────────────────────────────────────────────── */
.ft-bottom {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  padding-top: 1.25rem;
  padding-bottom: 1.5rem;
}

.ft-copy {
  font-family: var(--font-mono, ui-monospace);
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  color: #2E3D60;
}

.ft-bottom-links {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.ft-bottom-sep {
  color: #1C2A50;
  font-size: 0.7rem;
}

.ft-bottom-link {
  font-family: var(--font-mono, ui-monospace);
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  color: #2E3D60;
  text-decoration: none;
  transition: color 0.18s;
}

.ft-bottom-link:hover { color: #5B6FA3; }

.ft-bottom-link:focus-visible {
  outline: 1px solid #3DFF7A;
  outline-offset: 3px;
  border-radius: 2px;
}

.ft-made {
  font-family: var(--font-mono, ui-monospace);
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  color: #2E3D60;
}

/* ── Scroll reveal ─────────────────────────────────────────── */
.ft-reveal {
  opacity: 0;
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.ft-reveal-left  { transform: translateX(-2rem); }
.ft-reveal-right { transform: translateX(2rem); }
.ft-reveal-up    { transform: translateY(1.5rem); }

.ft-reveal.ft-is-visible {
  opacity: 1;
  transform: translate(0, 0);
}

.ft-reveal-d1 { transition-delay: 0.1s; }
.ft-reveal-d2 { transition-delay: 0.2s; }
.ft-reveal-d3 { transition-delay: 0.3s; }

/* ── Reduced motion ────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .ft-reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .ft-brand:hover .ft-rgb-r,
  .ft-brand:hover .ft-rgb-g,
  .ft-brand:hover .ft-rgb-b {
    animation: none;
  }
}

/* ── Responsive ────────────────────────────────────────────── */
@media (max-width: 860px) {
  .ft-body {
    grid-template-columns: 1fr 1fr;
  }

  .ft-brand {
    grid-column: 1 / -1;
    margin-bottom: 2rem;
  }

  .ft-watermark {
    font-size: clamp(6rem, 22vw, 14rem);
  }
}

@media (max-width: 560px) {
  .ft-body {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .ft-bottom {
    flex-direction: column;
    align-items: flex-start;
  }

  .ft-watermark {
    font-size: clamp(4rem, 28vw, 8rem);
  }
}
</style>

<script>
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const reveals = document.querySelectorAll('.ft-reveal');
  if (!reveals.length) return;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('ft-is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
  );

  reveals.forEach((el) => observer.observe(el));
})();
</script>
